# Development environment template.
# Copy to .env.development for apps/api and apps/web development tasks.

# apps/api - development service bindings and internal authentication
API_MIGRATION_DATABASE_URL=postgres://migrator:migrator_dev@127.0.0.1:5432/heyblog?sslmode=disable
API_DATABASE_URL=postgres://api_runtime:api_runtime_dev@127.0.0.1:5432/heyblog?sslmode=disable
API_REDIS_URL=redis://127.0.0.1:6379/0
API_HEALTHCHECK_TOKEN=development-healthcheck-token-0123456789
API_TEMP_IMPORT_TOKEN=development-temp-import-token-0123456789

# apps/api <-> apps/web - development service authentication
API_WEB_TOKEN=development-web-service-token-0123456789

# apps/web - development SSR upstream
WEB_API_BASE_URL=http://127.0.0.1:10201

# apps/web - optional server-only GitHub API token for member contribution data
GITHUB_TOKEN=
