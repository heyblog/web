# zhblogs environment template
# 规则：
# - 所有模块统一从根目录 .env.dev/.env.test/.env.prod 派生。
# - 生产必须覆盖：禁止直接沿用示例值。
# - 默认可沿用：开发可直接使用，生产按部署环境调整。
# - Cloudflare 生产密钥仍需同步到 Cloudflare Workers secrets。

# ============================================================
# 必需变量 / 共用 / 生产必须覆盖
# 来源：
# - apps/api/src/infrastructure/app/http/app-config.service.ts
# - apps/worker/src/config/config.go
# - apps/deployer/internal/config/config.go
# - packages/db/src/client.ts
# - packages/db/drizzle.config.ts
# - infra/docker/docker-compose.prod.yml
# ============================================================

NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/zhblogs
VALKEY_URL=valkey://localhost:6379


# ============================================================
# 必需变量 / apps/api / 生产必须覆盖
# 来源：apps/api/src/infrastructure/app/http/app-config.service.ts
# ============================================================

API_GITHUB_CLIENT_ID=github-client-id
API_GITHUB_CLIENT_SECRET=github-client-secret
API_GITHUB_CALLBACK_URL=http://127.0.0.1:9101/auth/github/callback
API_SMTP_HOST=smtp.example.com
API_SMTP_USER=smtp-user
API_SMTP_PASS=smtp-password
API_SMTP_FROM=noreply@example.com


# ============================================================
# 必需变量 / apps/api / 默认可沿用
# 来源：apps/api/src/infrastructure/app/http/app-config.service.ts
# ============================================================

API_GITHUB_SCOPE=read:user,user:email
API_SMTP_PORT=587
API_SMTP_SECURE=false


# ============================================================
# 必需变量 / apps/deployer / 生产必须覆盖
# 来源：
# - apps/deployer/internal/config/config.go
# - .github/workflows/main.yml
# - infra/github-workflows/main.with-deploy-service.yml
# - infra/docker/docker-compose.prod.yml
# ============================================================

DEPLOYER_NOTIFY_SECRET=replace-with-hmac-secret
DEPLOYER_REPO_DIR=/srv/zhblogs/core
DOCKERHUB_NAMESPACE=zhblogs


# ============================================================
# 必需变量 / CI and GitHub Actions / 生产必须覆盖
# 来源：
# - .github/workflows/main.yml
# - infra/github-workflows/main.with-deploy-service.yml
# ============================================================

DOCKERHUB_USERNAME=dockerhub-user
DOCKERHUB_TOKEN=dockerhub-token
DEPLOYER_NOTIFY_URL=https://deploy.example.com/webhooks/deploy
CLOUDFLARE_API_TOKEN=cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=cloudflare-account-id


# ============================================================
# 必需变量 / apps/cloudflare and apps/worker callback / 生产必须覆盖
# 来源：
# - apps/worker/src/config/config.go
# - apps/cloudflare/src/config.ts
# - apps/cloudflare/src/types.ts
# ============================================================

WORKER_CALLBACK_SECRET=dev-checker-token


# ============================================================
# 可选变量 / apps/api / 生产必须覆盖
# 来源：
# - apps/api/src/infrastructure/app/http/app-config.service.ts
# ============================================================

# API_WEB_BASE_URL 用于 API 重定向；邮件公开链接直接使用 WEB_PUBLIC_BASE_URL。
API_WEB_BASE_URL=http://127.0.0.1:9101
# 生产环境只保留真实对外来源；本地调试再追加 localhost / 127.0.0.1。
API_CORS_ORIGINS=http://127.0.0.1:9101,http://localhost:9101
API_JWT_ACCESS_SECRET=zhblogs-api-access-secret-for-dev-and-test-only
API_JWT_REFRESH_SECRET=zhblogs-api-refresh-secret-for-dev-and-test-only
API_INTERNAL_TOKEN=zhblogs-internal-dev-token


# ============================================================
# 可选变量 / apps/api / 默认可沿用
# 来源：
# - apps/api/src/infrastructure/app/http/app-config.service.ts
# - apps/api/src/shared/runtime/service/app-logger.service.ts
# ============================================================

API_PORT=9201
API_LOG_LEVEL=
API_LOG_DIR=./logs
API_COOKIE_DOMAIN=
API_JWT_ACCESS_TTL_SECONDS=21600
API_JWT_REFRESH_TTL_SECONDS=604800


# ============================================================
# 可选变量 / apps/web / 生产必须覆盖
# 来源：
# - apps/web/src/application/api/api-env.ts
# ============================================================

WEB_API_BASE_URL=http://127.0.0.1:9201
WEB_PUBLIC_BASE_URL=https://www.zhblogs.net


# ============================================================
# 可选变量 / Docker Compose host bindings / 默认可沿用
# 来源：
# - infra/docker/docker-compose.local.yml
# - infra/docker/docker-compose.prod.yml
# ============================================================

API_HOST_PORT=9201
WEB_HOST_PORT=9101
WORKER_HOST_PORT=9301


# ============================================================
# 可选变量 / apps/worker / 生产必须覆盖
# 来源：apps/worker/src/config/config.go
# ============================================================

WORKER_CALLBACK_URL=http://127.0.0.1:9501
WORKER_API_BASE_URL=http://127.0.0.1:9201


# ============================================================
# 可选变量 / apps/worker / 默认可沿用
# 来源：apps/worker/src/config/config.go
# ============================================================

WORKER_ID=
WORKER_PORT=9301
WORKER_POLL_INTERVAL_MS=2000
WORKER_SCHEDULE_INTERVAL_MS=5000
WORKER_CONSUME_BATCH=1
WORKER_CONSUME_CONCURRENCY=4
WORKER_SCHEDULE_BATCH=50
WORKER_JOB_HEARTBEAT_INTERVAL_MS=5000
WORKER_JOB_HEARTBEAT_TIMEOUT_MS=45000
WORKER_JOB_RETRY_LIMIT=2
WORKER_JOB_RETRY_DELAY_MS=5000
WORKER_SITE_CHECK_BATCH_CONCURRENCY=4
WORKER_RSS_FETCH_BATCH_CONCURRENCY=4
WORKER_HEALTH_BACKLOG_MAX=500
WORKER_HEALTH_NO_SUCCESS_MS=1800000
WORKER_CALLBACK_TIMEOUT_MS=5000
WORKER_API_TIMEOUT_MS=5000
TZ=Asia/Shanghai


# ============================================================
# 可选变量 / apps/deployer / 默认可沿用
# 来源：apps/deployer/internal/config/config.go
# ============================================================

DEPLOYER_COMPOSE_FILE=/srv/zhblogs/core/infra/docker/docker-compose.prod.yml
DEPLOYER_SYSTEMD_UNIT=zhblogs-deployer
DEPLOYER_HOST=127.0.0.1
DEPLOYER_PORT=9401
DEPLOYER_RULES_FILE=apps/deployer/deploy-rules.json
DEPLOYER_DOCKER_BIN=/usr/local/sbin/zhblogs-docker
DEPLOYER_SYSTEMCTL_BIN=/usr/local/sbin/zhblogs-systemctl
DEPLOYER_GO_BIN=go
DEPLOYER_BINARY_PATH=/srv/zhblogs/bin/zhblogs-deployer
DEPLOYER_CONFIG_SYNC_COMMAND=sudo /usr/local/sbin/zhblogs-apply-infra
DEPLOYER_ADMIN_NOTIFY_WEBHOOK=


# ============================================================
# 可选变量 / packages/db scripts / 迁移执行前必须覆盖
# 来源：packages/db/scripts/migrate-legacy-blogs.shared.ts
# ============================================================

OLD_DATABASE_URL=postgresql://postgres:password@localhost:5432/zhblogs_legacy
NEW_DATABASE_URL=postgresql://postgres:password@localhost:5432/zhblogs


# ============================================================
# 可选变量 / packages/db scripts / 默认可沿用
# 来源：packages/db/scripts/migrate-legacy-blogs.shared.ts
# ============================================================

MIGRATE_LEGACY_BATCH_SIZE=200
MIGRATE_LEGACY_DRY_RUN=true


# ============================================================
# 可选变量 / tests and CI / 默认可沿用
# 来源：
# - apps/web/playwright.config.ts
# - apps/web/tests/setup/env.ts
# - .github/workflows/main.yml
# ============================================================

CI=
PORT=
PLAYWRIGHT_WEB_PORT=9101
PLAYWRIGHT_WEB_BASE_URL=http://127.0.0.1:9101
IMAGE_TAG=local
