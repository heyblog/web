{
  "name": "heyblog-web",
  "type": "module",
  "engines": {
    "node": ">=24.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "format": "prettier --config ./prettier.config.ts --write \"package.json\" \"*.{ts,mjs}\" \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --config ./prettier.config.ts --check \"package.json\" \"*.{ts,mjs}\" \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte,css}\" \"tests/**/*.ts\"",
    "lint": "pnpm run lint:eslint && pnpm run stylelint",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run stylelint:fix",
    "lint:eslint": "astro sync && eslint --config ./eslint.config.ts \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte}\" \"tests/**/*.ts\" \"*.{ts,mjs}\"",
    "lint:eslint:fix": "astro sync && eslint --config ./eslint.config.ts \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte}\" \"tests/**/*.ts\" \"*.{ts,mjs}\" --fix",
    "stylelint": "stylelint --config ./stylelint.config.ts \"src/**/*.{css,astro,svelte}\"",
    "stylelint:fix": "stylelint --config ./stylelint.config.ts --fix \"src/**/*.{css,astro,svelte}\"",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/node": "^11.1.11",
    "@astrojs/svelte": "^9.1.1",
    "@heyblog/configs": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@tabler/icons-svelte": "^3.50.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.2",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "marked": "^18.1.3",
    "qrcode": "1.5.4",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/three": "^0.187.0",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-svelte": "^3.24.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "postcss-html": "^2.0.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
