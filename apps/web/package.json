{
  "name": "heyblog-web",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --config ./prettier.config.ts --write \"package.json\" \"*.{ts,mjs}\" \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --config ./prettier.config.ts --check \"package.json\" \"*.{ts,mjs}\" \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte,css}\" \"tests/**/*.ts\"",
    "lint": "pnpm run lint:eslint && pnpm run stylelint",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run stylelint:fix",
    "lint:eslint": "astro sync && eslint --config ./eslint.config.ts \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte}\" \"tests/**/*.ts\" \"*.{ts,mjs}\"",
    "lint:eslint:fix": "astro sync && eslint --config ./eslint.config.ts \"public/**/*.js\" \"src/**/*.{ts,js,astro,svelte}\" \"tests/**/*.ts\" \"*.{ts,mjs}\" --fix",
    "stylelint": "stylelint --config ./stylelint.config.ts \"src/**/*.{css,astro,svelte}\"",
    "stylelint:fix": "stylelint --config ./stylelint.config.ts --fix \"src/**/*.{css,astro,svelte}\"",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@heyblog/configs": "workspace:*",
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-svelte": "^3.22.0",
    "postcss-html": "^2.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
