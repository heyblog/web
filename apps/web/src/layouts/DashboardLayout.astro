---
import type { SessionUser } from '@/api/auth/auth.types';
import { managementNavigation } from '@/application/management/navigation';

import WorkspaceLayout from './WorkspaceLayout.astro';

interface Props {
  title: string;
  heading: string;
  user: SessionUser;
  currentPath: string;
}
const { title, heading, user, currentPath } = Astro.props;
const navigation = [
  { label: '我的站点', href: '/dashboard/sites' },
  { label: '站点认领', href: '/dashboard/claims' },
  { label: '申请记录', href: '/dashboard/submissions' },
  { label: '个人资料', href: '/dashboard/profile' },
  { label: '账号安全', href: '/dashboard/security' },
];
---

<WorkspaceLayout
  {title}
  {heading}
  {currentPath}
  eyebrow="个人工作区"
  workspace="personal"
  canManage={managementNavigation(user).length > 0}
  identity={{ displayName: user.display_name, email: user.email ?? '', roleLabel: user.role }}
  {navigation}
>
  <slot />
</WorkspaceLayout>
