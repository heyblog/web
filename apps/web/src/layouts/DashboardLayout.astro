---
import type { SessionUser } from '@/api/auth/auth.types';
import { managementNavigation } from '@/application/management/navigation';

import ManagementLayout from './ManagementLayout.astro';

interface Props {
  title: string;
  heading: string;
  user: SessionUser;
  currentPath: string;
}
const { title, heading, user, currentPath } = Astro.props;
const navigation = [
  { label: '工作台', href: '/dashboard' },
  { label: '我的站点', href: '/dashboard/sites' },
  { label: '认证申请', href: '/dashboard/claims' },
  { label: '我的提交', href: '/dashboard/submissions' },
  { label: '账号安全', href: '/dashboard/security' },
  ...managementNavigation(user),
];
---

<ManagementLayout
  {title}
  {heading}
  {currentPath}
  eyebrow="用户工作台"
  identity={{ displayName: user.display_name, email: user.email ?? '', roleLabel: user.role }}
  {navigation}
>
  <slot />
</ManagementLayout>
