---
import type { SessionUser } from '@/api/auth/auth.types';

import ManagementLayout from './ManagementLayout.astro';

interface Props {
  title: string;
  heading: string;
  user: SessionUser;
  currentPath: string;
}
const { title, heading, user, currentPath } = Astro.props;
const navigation = [{ label: '账号安全', href: '/dashboard/security' }];
---

<ManagementLayout
  {title}
  {heading}
  {currentPath}
  eyebrow="用户工作台"
  identity={{ displayName: user.display_name, email: user.email ?? '', roleLabel: user.role }}
  {navigation}
>
  <slot />
</ManagementLayout>
