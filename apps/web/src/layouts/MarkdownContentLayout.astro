---
import ContentBody from '@/components/content-page/ContentBody.astro';
import ContentToc from '@/components/content-page/ContentToc.astro';
import ContentTocBehavior from '@/components/content-page/ContentTocBehavior.astro';
import EntryHeader from '@/components/content-page/EntryHeader.astro';

import PublicLayout from './PublicLayout.astro';

interface MarkdownFrontmatter {
  title?: string;
  description?: string;
  create_time?: string | Date;
  update_time?: string | Date;
}

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props extends MarkdownFrontmatter {
  headings?: TocHeading[];
  frontmatter?: MarkdownFrontmatter;
}

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? '未命名页面';
const description = Astro.props.description ?? frontmatter.description;
const createTime = Astro.props.create_time ?? frontmatter.create_time;
const updateTime = Astro.props.update_time ?? frontmatter.update_time;
const headings = Astro.props.headings ?? [];
const hasToc = headings.some(
  (heading) => heading.depth >= 2 && heading.depth <= 4 && heading.slug && heading.text,
);
---

<PublicLayout
  {title}
  {description}
  ogType="article"
  publishedTime={createTime}
  modifiedTime={updateTime}
>
  <div
    class="mx-auto grid w-[min(calc(100%-2rem),80rem)] gap-8 pt-8 pb-16 sm:w-[min(calc(100%-3rem),80rem)] sm:pt-12 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-12"
    data-content-page
  >
    <article
      class:list={[
        'min-w-0',
        {
          '**:data-entry-header:border-b-0 md:**:data-entry-header:border-b': hasToc,
        },
      ]}
      data-content-article
    >
      <EntryHeader {title} {description} {createTime} {updateTime}>
        <slot name="meta" slot="meta" />
      </EntryHeader>
      <ContentToc {headings} variant="mobile" />
      <ContentBody>
        <slot />
      </ContentBody>
    </article>
    <ContentToc {headings} variant="desktop" />
    <ContentTocBehavior />
  </div>
</PublicLayout>
