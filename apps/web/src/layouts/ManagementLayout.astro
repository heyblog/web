---
import WorkspaceLayout, { type Props as WorkspaceProps } from './WorkspaceLayout.astro';
type Props = Omit<WorkspaceProps, 'workspace' | 'canManage'>;
const { navigation, ...props } = Astro.props;
---

<WorkspaceLayout
  {...props}
  eyebrow="管理工作区"
  workspace="management"
  navigation={[{ label: '管理首页', href: '/management' }, ...navigation]}
>
  <slot />
</WorkspaceLayout>
