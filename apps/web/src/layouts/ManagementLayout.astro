---
import { IconChevronDown } from '@tabler/icons-svelte';

import { siteConfig } from '@/site.config';

import BaseLayout from './BaseLayout.astro';

export interface ManagementIdentityView {
  displayName: string;
  email: string;
  roleLabel: string;
  statusLabel?: string;
}

export interface ManagementNavigationItem {
  label: string;
  href: string;
  description?: string;
}

interface Props {
  title: string;
  heading: string;
  currentPath: string;
  eyebrow?: string;
  identity?: ManagementIdentityView;
  navigation: ManagementNavigationItem[];
}

const { title, heading, currentPath, eyebrow = '管理中心', identity, navigation } = Astro.props;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<BaseLayout {title} bodyClass="min-h-screen">
  <header class="flex min-h-16 items-center border-b border-line px-4" data-page-header>
    <a
      class="inline-flex min-w-0 items-center gap-3 text-base font-semibold"
      href="/"
      aria-label={`${siteConfig.name} 首页`}
    >
      <img
        class="size-10 shrink-0 rounded-md sm:size-9"
        src="/favicon.svg"
        alt=""
        width="40"
        height="40"
      />
      <span>{siteConfig.name}</span>
    </a>
  </header>

  <div class="grid min-h-[calc(100vh-4rem)] lg:grid-cols-[17rem_minmax(0,1fr)]">
    <aside class="border-b border-line bg-surface lg:border-r lg:border-b-0">
      <details
        class="group lg:sticky lg:top-0"
        open
        data-management-navigation
        data-details-state="open"
      >
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center justify-between px-4 text-sm font-semibold lg:hidden [&::-webkit-details-marker]:hidden"
          data-management-navigation-trigger
        >
          <span>管理导航</span>
          <IconChevronDown
            class="shrink-0 transition-transform duration-(--motion-base) ease-standard group-data-[details-state=open]:rotate-180 motion-reduce:transition-none motion-reduce:duration-0"
            data-management-navigation-chevron
            aria-hidden="true"
            size={18}
            stroke={1.75}
          />
        </summary>
        <div
          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-(--motion-base) ease-standard group-data-[details-state=open]:grid-rows-[1fr] motion-reduce:transition-none motion-reduce:duration-0 lg:grid-rows-[1fr]"
          data-management-navigation-panel
        >
          <div class="min-h-0 overflow-hidden">
            <div class="grid gap-6 border-t border-line p-4 lg:border-t-0 lg:p-6">
              {
                identity ? (
                  <section class="grid gap-1" aria-label="当前账号">
                    <strong>{identity.displayName}</strong>
                    <span class="text-xs text-fg-muted">{identity.email}</span>
                    <dl class="mt-3 grid gap-2">
                      <div class="flex justify-between gap-4">
                        <>
                          <dt class="text-xs text-fg-muted">角色</dt>
                          <dd class="m-0 text-xs font-medium">{identity.roleLabel}</dd>
                        </>
                      </div>
                      {identity.statusLabel ? (
                        <div class="flex justify-between gap-4">
                          <dt class="text-xs text-fg-muted">状态</dt>
                          <dd class="m-0 text-xs font-medium">{identity.statusLabel}</dd>
                        </div>
                      ) : null}
                    </dl>
                  </section>
                ) : null
              }
              <nav class="grid gap-1" aria-label="管理模块">
                {
                  navigation.map((item) => (
                    <a
                      class:list={[
                        'grid min-h-11 content-center gap-1 rounded-sm px-3 py-2.5 text-fg-muted transition-[background-color,color] duration-(--motion-color) ease-standard hover:bg-tint hover:text-tint-fg',
                        { 'bg-tint text-tint-fg': isActive(item.href) },
                      ]}
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                    >
                      <strong class="text-sm font-medium">{item.label}</strong>
                      {item.description ? <span class="text-xs">{item.description}</span> : null}
                    </a>
                  ))
                }
              </nav>
            </div>
          </div>
        </div>
      </details>
    </aside>

    <main class="min-w-0 px-4 pt-6 pb-12 sm:px-8 sm:pt-8 sm:pb-16 lg:w-[min(100%,80rem)] lg:p-12">
      <header class="mb-8 border-b border-line pb-6">
        <p class="mb-4 font-mono text-xs font-medium text-tint-fg">{eyebrow}</p>
        <h1 class="text-[2rem] leading-tight font-bold sm:text-4xl">{heading}</h1>
      </header>
      <slot />
    </main>
  </div>

  <script>
    import {
      type AnimatedDetailsController,
      setupAnimatedDetails,
    } from '@/shared/animated-details.browser';

    const navigationControllers: Array<{
      controller: AnimatedDetailsController;
      details: HTMLDetailsElement;
    }> = [];

    document
      .querySelectorAll<HTMLDetailsElement>('[data-management-navigation]')
      .forEach((details) => {
        const panel = details.querySelector<HTMLElement>('[data-management-navigation-panel]');

        if (panel) {
          navigationControllers.push({
            controller: setupAnimatedDetails(details, { panel }),
            details,
          });
        }
      });

    const desktopNavigation = window.matchMedia('(min-width: 80rem)');
    const syncDesktopNavigation = () => {
      if (desktopNavigation.matches) {
        navigationControllers.forEach(({ controller }) => controller.open());
      }
    };

    desktopNavigation.addEventListener('change', syncDesktopNavigation);
    syncDesktopNavigation();
  </script>
</BaseLayout>
