---
import AnnouncementBanner from '@/components/announcements/AnnouncementBanner.astro';
import PublicHeader from '@/components/chrome/PublicHeader.astro';
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import type { StructuredData } from '@/shared/structured-data';

import BaseLayout from './BaseLayout.astro';

interface Props {
  structuredData?: readonly StructuredData[];
  title?: string;
  siteName?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  imagePath?: string;
  imageAlt?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  robots?: string;
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  showFooter?: boolean;
  showAnnouncementBanner?: boolean;
  enableAnalytics?: boolean;
}

const {
  enableAnalytics = true,
  showFooter = true,
  showAnnouncementBanner = true,
  ...metadata
} = Astro.props;
---

<BaseLayout {...metadata} {enableAnalytics} bodyClass="flex min-h-dvh flex-col">
  <PublicHeader currentPath={Astro.url.pathname} />
  {showAnnouncementBanner ? <AnnouncementBanner server:defer /> : null}
  <main class="flex w-full flex-1 flex-col">
    <slot />
  </main>
  {showFooter ? <SiteFooter /> : null}
</BaseLayout>
