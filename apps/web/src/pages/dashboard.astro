---
import { requestAuthAPI } from '@/api/auth/auth.server';
import { readSessionUser } from '@/application/auth/auth.server';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = await readSessionUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + encodeURIComponent(Astro.url.pathname));
const responses = await Promise.all(
  ['sites', 'site-claims', 'site-submissions'].map((path) =>
    requestAuthAPI(Astro.request, `/account/${path}`),
  ),
);
const counts = await Promise.all(
  responses.map(async (response) => {
    if (!response.ok) return null;
    const payload: unknown = await response.json();
    if (
      typeof payload !== 'object' ||
      payload === null ||
      !('items' in payload) ||
      !Array.isArray(payload.items)
    )
      return null;
    return payload.items.length;
  }),
);
const links = [
  { label: '我的站点', href: '/dashboard/sites', count: counts[0] },
  { label: '近期认证申请', href: '/dashboard/claims', count: counts[1] },
  { label: '近期提交', href: '/dashboard/submissions', count: counts[2] },
];
---

<DashboardLayout title="工作台" heading="工作台" {user} currentPath={Astro.url.pathname}>
  <AuthNotice
    message={counts.some((count) => count === null) ? '部分数据暂时无法加载，请稍后重试。' : null}
  />
  <dl class="grid gap-px border-y border-line bg-line sm:grid-cols-3">
    {links.map((item) => (
      <div class="bg-surface p-6">
        <dt class="text-sm text-fg-muted">{item.label}</dt>
        <dd class="mt-3 text-3xl font-semibold">{item.count ?? '—'}</dd>
        <a
          class="mt-4 inline-flex min-h-11 items-center text-sm text-tint-fg underline"
          href={item.href}
        >
          查看{item.label}
        </a>
      </div>
    ))}
  </dl>
  <div class="mt-8 flex flex-wrap gap-4">
    <a
      class="inline-flex min-h-11 items-center rounded-sm bg-primary px-5 font-semibold text-primary-fg"
      href="/dashboard/claims"
    >
      认证站点
    </a>
    <a
      class="inline-flex min-h-11 items-center rounded-sm border border-line-strong px-5 text-sm font-medium"
      href="/dashboard/sites/new"
    >
      提交新站点
    </a>
    <form method="post" action="/auth/logout">
      <button class="min-h-11 rounded-sm border border-line-strong px-5 text-sm" type="submit">
        退出登录
      </button>
    </form>
  </div>
</DashboardLayout>
