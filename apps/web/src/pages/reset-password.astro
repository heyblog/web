---
import { IconKey } from '@tabler/icons-svelte';

import { authErrorMessage } from '@/application/auth/auth-page';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const token = Astro.url.searchParams.get('token')?.trim() ?? '';
---

<AuthLayout title="重置密码 | HeyBlog" heading="设置新密码" description="重置链接仅可使用一次。">
  <AuthNotice message={authErrorMessage(Astro.url.searchParams.get('error'))} />
  {
    token ? (
      <form class="grid gap-4" method="post" action="/auth/password/reset">
        <input type="hidden" name="token" value={token} />
        <label class="grid gap-1.5 text-sm font-medium">
          新密码
          <input
            class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
          />
        </label>
        <label class="grid gap-1.5 text-sm font-medium">
          确认新密码
          <input
            class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
            name="confirm_password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
          />
        </label>
        <button
          class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
          type="submit"
        >
          <IconKey size={18} stroke={1.8} aria-hidden="true" />
          更新密码
        </button>
      </form>
    ) : (
      <AuthNotice message="密码重置链接无效。" />
    )
  }
</AuthLayout>
