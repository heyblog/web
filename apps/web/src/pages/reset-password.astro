---
import { IconKey } from '@tabler/icons-svelte';

import { authErrorField } from '@/application/auth/auth-fields';
import { authErrorMessage } from '@/application/auth/auth-page';
import AuthField from '@/components/auth/AuthField.astro';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const token = Astro.url.searchParams.get('token')?.trim() ?? '';
---

<AuthLayout
  title="重置密码 | HeyBlog"
  heading="设置新密码"
  description="重置链接 30 分钟内有效，且仅可使用一次。"
>
  <AuthNotice
    message={
      authErrorField(Astro.url.searchParams.get('error'))
        ? null
        : authErrorMessage(Astro.url.searchParams.get('error'))
    }
  />
  {token ? (
    <form
      class="grid gap-4"
      method="post"
      action="/api/web/auth/password/reset"
      data-field-feedback
    >
      <input type="hidden" name="token" value={token} />
      <AuthField
        name="password"
        label="新密码"
        autocomplete="new-password"
        type="password"
        validation="new-password"
        help="8–128 字节；中文和表情占多个字节。"
      />
      <AuthField
        name="confirm_password"
        label="确认新密码"
        autocomplete="new-password"
        type="password"
        match="password"
        help="再次输入相同的密码。"
      />
      <button
        class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
        type="submit"
      >
        <IconKey size={18} stroke={1.8} aria-hidden="true" />
        更新密码
      </button>
    </form>
  ) : (
    <AuthNotice message="密码重置链接无效。" />
  )}
</AuthLayout>
