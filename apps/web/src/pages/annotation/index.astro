---
import { readAnnotation } from '@/api/site-annotation/annotation.server';
import { parseAnnotationStats } from '@/api/site-annotation/annotation-responses';
import { canAnnotateSites } from '@/application/site-annotation/annotation-access';
import {
  annotationFailure,
  annotationListPath,
  statusLabels,
} from '@/application/site-annotation/annotation-view';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import { linkClass, sectionClass } from '@/components/site-annotation/annotation.styles';
import AnnotationStartButton from '@/components/site-annotation/AnnotationStartButton.svelte';
import AnnotationLayout from '@/layouts/AnnotationLayout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const actor = Astro.locals.sessionUser;
if (!actor)
  return Astro.redirect('/login?next=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
if (!canAnnotateSites(actor)) return Astro.redirect('/forbidden');

const {
  data: stats,
  status: responseStatus,
  headers,
} = await readAnnotation(Astro.request, 'stats', parseAnnotationStats);
for (const cookie of headers.getSetCookie()) Astro.response.headers.append('Set-Cookie', cookie);
if (!stats) Astro.response.status = responseStatus;

const completionPercent =
  stats && stats.total > 0 ? Math.round((stats.annotated / stats.total) * 100) : 0;

const statusBreakdown = stats
  ? [
      {
        status: 'UNREVIEWED' as const,
        count: stats.unreviewed,
        badgeClass: 'bg-warning-bg text-warning-fg',
      },
      {
        status: 'BLOG' as const,
        count: stats.blog,
        badgeClass: 'bg-success-bg text-success-fg',
      },
      {
        status: 'NON_BLOG' as const,
        count: stats.non_blog,
        badgeClass: 'bg-subtle text-fg-muted',
      },
    ]
  : [];
---

<AnnotationLayout {actor} heading="标注状态区">
  {stats ? (
    <div class="grid min-w-0 gap-6">
      <section class={sectionClass} aria-labelledby="annotation-start">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="grid gap-1">
            <h2 id="annotation-start" class="text-lg font-semibold">
              {stats.unreviewed > 0
                ? `当前有 ${stats.unreviewed} 个待标注博客`
                : '所有站点均已完成标注'}
            </h2>
            <p class="text-sm text-fg-muted">
              点击开始标注将随机进入一个未标注的站点，标完可直接切到下一个。
            </p>
          </div>
          <AnnotationStartButton unreviewed={stats.unreviewed} client:load />
        </div>
        <div class="grid gap-2 border-t border-line pt-4">
          <div class="flex items-center justify-between text-sm">
            <span class="text-fg-muted">总体标注进度</span>
            <span class="font-medium">
              {stats.annotated} / {stats.total}（{completionPercent}%）
            </span>
          </div>
          <div class="h-2.5 w-full overflow-hidden rounded-full bg-subtle">
            <div class="h-full rounded-full bg-primary" style={`width: ${completionPercent}%`} />
          </div>
        </div>
      </section>

      <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="标注统计概览">
        <div class="grid gap-1 rounded-md border border-line bg-surface p-4">
          <span class="text-sm text-fg-muted">总站点数</span>
          <strong class="text-2xl font-semibold">{stats.total}</strong>
        </div>
        <div class="grid gap-1 rounded-md border border-line bg-surface p-4">
          <span class="text-sm text-fg-muted">已标注</span>
          <strong class="text-2xl font-semibold">{stats.annotated}</strong>
        </div>
        <div class="grid gap-1 rounded-md border border-line bg-surface p-4">
          <span class="text-sm text-fg-muted">待标注</span>
          <strong class="text-2xl font-semibold text-warning-fg">{stats.unreviewed}</strong>
        </div>
        <div class="grid gap-1 rounded-md border border-line bg-surface p-4">
          <span class="text-sm text-fg-muted">当前账号已标注</span>
          <strong class="text-2xl font-semibold">{stats.actor_annotated}</strong>
          <span class="text-xs text-fg-muted">今日已标注 {stats.actor_today_annotated} 个</span>
        </div>
      </section>

      <section class={sectionClass} aria-labelledby="annotation-status-distribution">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="annotation-status-distribution" class="text-lg font-semibold">
            各标注状态分布
          </h2>
          <a class={linkClass} href={annotationListPath}>
            进入站点目录
          </a>
        </div>
        <ul class="grid gap-3 sm:grid-cols-3">
          {statusBreakdown.map((item) => {
            const ratio = stats.total > 0 ? Math.round((item.count / stats.total) * 100) : 0;
            return (
              <li class="rounded-md border border-line p-4">
                <a
                  class="grid gap-2 hover:opacity-85"
                  href={`${annotationListPath}?status=${item.status}`}
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class={`rounded-sm px-2 py-0.5 text-xs font-medium ${item.badgeClass}`}>
                      {statusLabels[item.status]}
                    </span>
                    <span class="text-xs text-fg-muted">{ratio}%</span>
                  </div>
                  <strong class="text-2xl font-semibold">{item.count}</strong>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  ) : (
    <AuthNotice message={annotationFailure(responseStatus, 'load')} />
  )}
</AnnotationLayout>
