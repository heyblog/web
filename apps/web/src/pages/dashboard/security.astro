---
import { IconKey, IconLogout2 } from '@tabler/icons-svelte';

import { oauthProviders } from '@/api/auth/oauth.types';
import { authErrorMessage, authStatusMessage } from '@/application/auth/auth-page';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import OAuthButton from '@/components/auth/OAuthButton.svelte';
import DashboardLayout from '@/layouts/DashboardLayout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = Astro.locals.sessionUser;
if (!user) return Astro.redirect('/login?next=%2Fdashboard%2Fsecurity');
---

<DashboardLayout title="账号安全" heading="账号安全" {user} currentPath={Astro.url.pathname}>
  <section class="grid gap-6">
    <header class="mb-8 flex flex-wrap items-start justify-between gap-4 border-b border-line pb-6">
      <div>
        <p class="mb-2 text-sm text-fg-muted">{user.email}</p>
        <p class="text-lg font-semibold">{user.display_name}</p>
      </div>
      <form method="post" action="/api/web/auth/logout">
        <button
          class="inline-flex min-h-11 items-center gap-2 rounded-sm border border-line-strong px-4 text-sm font-medium hover:bg-subtle"
          type="submit"
        >
          <IconLogout2 size={18} stroke={1.8} aria-hidden="true" />
          退出登录
        </button>
      </form>
    </header>
    <AuthNotice message={authErrorMessage(Astro.url.searchParams.get('error'))} />
    <AuthNotice message={authStatusMessage(Astro.url.searchParams.get('status'))} kind="success" />
    <dl class="mb-10 grid gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-surface p-4">
        <dt class="text-xs text-fg-muted">角色</dt>
        <dd class="mt-1 font-medium">{user.role}</dd>
      </div>
      <div class="bg-surface p-4">
        <dt class="text-xs text-fg-muted">邮箱</dt>
        <dd class="mt-1 font-medium">{user.email_verified ? '已验证' : '未验证'}</dd>
      </div>
      <div class="bg-surface p-4">
        <dt class="text-xs text-fg-muted">本地密码</dt>
        <dd class="mt-1 font-medium">{user.has_password ? '已设置' : '未设置'}</dd>
      </div>
      <div class="bg-surface p-4">
        <dt class="text-xs text-fg-muted">第三方登录</dt>
        <dd class="mt-1 font-medium">
          {user.oauth_providers
            .map((provider) => (provider === 'GITHUB' ? 'GitHub' : 'BlogsClub'))
            .join('、') || '未绑定'}
        </dd>
      </div>
    </dl>
    <div class="grid gap-10 lg:grid-cols-2">
      <section aria-labelledby="password-heading">
        <h2 class="mb-5 flex items-center gap-2 text-xl font-semibold" id="password-heading">
          <IconKey size={20} stroke={1.8} aria-hidden="true" />
          {user.has_password ? '修改密码' : '设置密码'}
        </h2>
        <form class="grid gap-4" method="post" action="/api/web/auth/password">
          {user.has_password ? (
            <label class="grid gap-1.5 text-sm font-medium">
              当前密码
              <input
                class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
                name="current_password"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>
          ) : null}
          <label class="grid gap-1.5 text-sm font-medium">
            新密码
            <input
              class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
              name="next_password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              maxlength="128"
              required
            />
          </label>
          <label class="grid gap-1.5 text-sm font-medium">
            确认新密码
            <input
              class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
              name="confirm_password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              maxlength="128"
              required
            />
          </label>
          <button
            class="min-h-11 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
            type="submit"
          >
            保存密码
          </button>
        </form>
      </section>
      <section aria-labelledby="oauth-heading">
        <h2 class="mb-5 text-xl font-semibold" id="oauth-heading">
          第三方登录
        </h2>
        <p class="mb-5 text-sm/normal text-fg-muted">绑定后可用于登录；解绑前请先设置本地密码。</p>
        <div class="grid gap-5">
          {oauthProviders.map((provider) => {
            const name = provider === 'github' ? 'GitHub' : 'BlogsClub';
            const bound = user.oauth_providers.includes(
              provider === 'github' ? 'GITHUB' : 'BLOGSCLUB',
            );
            return (
              <div class="grid gap-3 rounded-md border border-line p-4">
                <h3 class="text-sm font-semibold">
                  {name} · {bound ? '已绑定' : '未绑定'}
                </h3>
                {bound ? (
                  <form method="post" action={`/api/web/auth/${provider}/unbind`}>
                    <button
                      class="min-h-11 rounded-sm bg-danger-bg px-4 text-sm font-semibold text-danger-fg disabled:cursor-not-allowed disabled:opacity-50"
                      disabled={!user.has_password}
                      type="submit"
                    >
                      解绑 {name}
                    </button>
                  </form>
                ) : (
                  <OAuthButton
                    {provider}
                    intent="bind"
                    next="/dashboard/security"
                    label={`绑定 ${name}`}
                    client:load
                  />
                )}
              </div>
            );
          })}
        </div>
      </section>
    </div>
  </section>
</DashboardLayout>
