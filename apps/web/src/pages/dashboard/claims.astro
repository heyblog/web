---
import { requestAuthAPI } from '@/api/auth/auth.server';
import { parseClaims } from '@/api/site-management/site-management.types';
import { readSessionUser } from '@/application/auth/auth.server';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import ClaimManager from '@/components/site-management/ClaimManager.svelte';
import PageNavigation from '@/components/site-management/PageNavigation.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = await readSessionUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + encodeURIComponent(Astro.url.pathname));
const page = Math.min(
  1000,
  Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1),
);
const response = await requestAuthAPI(
  Astro.request,
  `/account/site-claims?page=${page}&page_size=50`,
);
const claims = response.ok ? parseClaims(await response.json()) : [];
---

<DashboardLayout title="认证申请" heading="认证申请" {user} currentPath={Astro.url.pathname}>
  <AuthNotice message={response.ok ? null : '认证记录暂时无法加载，请刷新重试。'} />
  <ClaimManager
    client:load
    initial={claims}
    initialShortId={Astro.url.searchParams.get('short_id') ?? ''}
  />
  <PageNavigation {page} hasNext={claims.length === 50} />
</DashboardLayout>
