---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import { resolveContentEditors } from '@/application/static-content/static-content.server';
import ContentEntryMeta from '@/components/content-page/ContentEntryMeta.astro';
import { readBlogEntries } from '@/integrations/content/content.server';
import MarkdownContentLayout from '@/layouts/MarkdownContentLayout.astro';
import { articleStructuredData, breadcrumbStructuredData } from '@/shared/structured-data';

interface Props {
  entry: CollectionEntry<'blogs'>;
}

export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await readBlogEntries();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const editors = await resolveContentEditors(entry.data.editors);
---

<MarkdownContentLayout
  ogType="article"
  structuredData={[
    articleStructuredData({
      title: entry.data.title,
      description: entry.data.description,
      path: `/blog/${entry.id}`,
      publishedTime: entry.data.create_time,
      modifiedTime: entry.data.update_time,
      authors: editors,
    }),
    breadcrumbStructuredData([
      { name: '首页', path: '/' },
      { name: '项目博客', path: '/blog' },
      { name: entry.data.title, path: `/blog/${entry.id}` },
    ]),
  ]}
  update_time={entry.data.update_time}
  title={entry.data.title}
  description={entry.data.description}
  create_time={entry.data.create_time}
  canonicalPath={`/blog/${entry.id}`}
  headings={headings}
  backLink={{ href: '/blog', label: '项目博客' }}
>
  <ContentEntryMeta
    slot="meta"
    {editors}
    category={entry.data.category}
    tags={entry.data.tags}
    pinned={entry.data.top}
  />
  <Content />
</MarkdownContentLayout>
