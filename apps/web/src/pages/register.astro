---
import { IconUserPlus } from '@tabler/icons-svelte';

import { authErrorField } from '@/application/auth/auth-fields';
import { authErrorMessage } from '@/application/auth/auth-page';
import AuthField from '@/components/auth/AuthField.astro';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const error = authErrorMessage(Astro.url.searchParams.get('error'));
---

<AuthLayout
  title="注册 | HeyBlog"
  heading="创建账号"
  description="注册后需要使用邮箱验证码激活账号。"
>
  <AuthNotice message={authErrorField(Astro.url.searchParams.get('error')) ? null : error} />
  <form class="grid gap-4" method="post" action="/api/web/auth/register" data-field-feedback>
    <AuthField
      name="username"
      label="用户名"
      autocomplete="username"
      validation="username"
      pattern="[a-z0-9_]{3,32}"
      help="3–32 位小写字母、数字或下划线。"
    />
    <AuthField name="email" label="邮箱" autocomplete="email" type="email" />
    <AuthField
      name="password"
      label="密码"
      autocomplete="new-password"
      type="password"
      validation="new-password"
      help="8–128 字节；中文和表情占多个字节。"
    />
    <AuthField
      name="confirm_password"
      label="确认密码"
      autocomplete="new-password"
      type="password"
      match="password"
      help="再次输入相同的密码。"
    />
    <button
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
      type="submit"
    >
      <IconUserPlus size={18} stroke={1.8} aria-hidden="true" />
      创建账号
    </button>
  </form>
  <p class="mt-6 text-center text-sm text-fg-muted">
    已有账号？{' '}
    <a class="text-tint-fg hover:underline" href="/login">
      登录
    </a>
  </p>
</AuthLayout>
