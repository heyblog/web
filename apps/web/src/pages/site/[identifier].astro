---
import {
  canonicalSiteRedirectPath,
  loadSiteByIdentifier,
} from '@/application/site-profile/site-profile.server';
import SiteProfileRoute from '@/components/site-profile/SiteProfileRoute.astro';

export const prerender = false;

const identifier = Astro.params.identifier ?? '';
const loaded = await loadSiteByIdentifier(identifier, Astro.request.signal);
const redirectPath = canonicalSiteRedirectPath(identifier, loaded);
if (redirectPath) {
  return Astro.redirect(redirectPath, 308);
}
const result = loaded.kind === 'bad-request' ? ({ kind: 'not-found' } as const) : loaded;

Astro.response.headers.set('Cache-Control', 'no-store');
if (result.kind === 'not-found') {
  Astro.response.status = 404;
} else if (result.kind === 'unavailable') {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}
---

<SiteProfileRoute {result} requestedPath={Astro.url.pathname} />
