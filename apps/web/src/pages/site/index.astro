---
import type {
  SiteDirectoryOptions,
  SiteDirectoryView,
} from '@/application/site-directory/site-directory.models';
import {
  loadSiteDirectory,
  loadSiteDirectoryOptions,
} from '@/application/site-directory/site-directory.server';
import { parseSiteDirectorySearchParams } from '@/application/site-directory/site-directory.shared';
import SiteDirectoryPage from '@/components/site-directory/SiteDirectoryPage.svelte';
import PublicLayout from '@/layouts/PublicLayout.astro';

export const prerender = false;

const query = parseSiteDirectorySearchParams(Astro.url.searchParams);
const [directoryResult, optionsResult] = await Promise.all([
  loadSiteDirectory(query, Astro.request),
  loadSiteDirectoryOptions(Astro.request),
]);
const fallbackView: SiteDirectoryView = {
  items: [],
  pagination: { page: 1, pageSize: 24, totalItems: 0, totalPages: 1 },
  query,
  statusCounts: { normal: 0, abnormal: 0 },
};
const fallbackOptions: SiteDirectoryOptions = {
  primaryTags: [],
  secondaryTags: [],
  warnings: [],
  technologies: [],
};
const initialView = directoryResult.kind === 'success' ? directoryResult.data : fallbackView;
const options = optionsResult.kind === 'success' ? optionsResult.data : fallbackOptions;
const unavailable = directoryResult.kind !== 'success';

Astro.response.headers.set('Cache-Control', 'no-store');
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}
---

<PublicLayout
  title="博客列表"
  description="浏览 HeyBlog 收录的公开独立博客。"
  canonicalPath="/site"
>
  {
    unavailable ? (
      <section class="mx-auto flex min-h-96 w-[min(calc(100%-2rem),80rem)] flex-col items-center justify-center py-16 text-center sm:w-[min(calc(100%-3rem),80rem)]">
        <span class="inline-flex size-12 items-center justify-center rounded-md bg-subtle font-mono text-sm font-semibold text-fg-muted">
          HB
        </span>
        <h1 class="mt-4 text-xl font-semibold">博客列表暂不可用</h1>
        <p class="mt-2 text-sm text-fg-muted">请稍后重新加载。</p>
      </section>
    ) : (
      <SiteDirectoryPage client:load {initialView} {options} />
    )
  }
</PublicLayout>
