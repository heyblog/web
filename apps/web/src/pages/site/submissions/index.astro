---
import PublicHeader from '@/components/chrome/PublicHeader.astro';
import SiteSubmissionHub from '@/components/site-submission/SiteSubmissionHub.astro';
import SiteSubmissionNavigation from '@/components/site-submission/SiteSubmissionNavigation.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="站点申请中心">
  <PublicHeader currentPath={Astro.url.pathname} />
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
    <SiteSubmissionNavigation currentPath={Astro.url.pathname} />
    <header class="mb-8 max-w-2xl">
      <p class="font-mono text-xs text-tint-fg">site submissions</p><h1
        class="mt-3 text-3xl font-bold"
      >
        站点申请中心
      </h1><p class="mt-3 text-fg-muted">提交新站点，维护已有站点资料，或查询申请处理进度。</p>
    </header>
    <SiteSubmissionHub />
  </main>
</BaseLayout>
