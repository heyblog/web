---
import type { AISettings } from '@/api/taxonomy/system-settings.types';
import { readSettingsPage } from '@/api/taxonomy/taxonomy.server';
import { readSessionUser } from '@/application/auth/auth.server';
import { managementNavigation } from '@/application/management/navigation';
import SystemSettings from '@/components/management/tags/SystemSettings.svelte';
import ManagementLayout from '@/layouts/ManagementLayout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const actor = await readSessionUser(Astro.request);
if (!actor) return Astro.redirect('/login?next=%2Fmanagement%2Fsystem-settings');
if (actor.role !== 'SYS_ADMIN') return Astro.redirect('/forbidden');
let initialSettings: AISettings | null = null;
let initialError: string | null = null;
try {
  initialSettings = await readSettingsPage(Astro.request);
} catch (error) {
  if (!(error instanceof Error)) throw error;
  initialError = '系统设置暂时无法加载，请刷新重试。';
}
---

<ManagementLayout
  title="系统设置 | HeyBlog"
  heading="系统设置"
  currentPath={Astro.url.pathname}
  identity={{ displayName: actor.display_name, email: actor.email ?? '', roleLabel: actor.role }}
  navigation={[...managementNavigation(actor)]}
>
  <SystemSettings client:load {initialSettings} {initialError} />
</ManagementLayout>
