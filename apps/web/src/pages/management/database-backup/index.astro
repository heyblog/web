---
import { readBackupUploads } from '@/api/database-backup/database-backup.settings.server';
import { backupMessage } from '@/application/database-backup/database-backup.messages';
import { managementNavigation } from '@/application/management/navigation';
import BackupManager from '@/components/management/database-backup/BackupManager.svelte';
import ManagementLayout from '@/layouts/ManagementLayout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const actor = Astro.locals.sessionUser;
if (!actor) return Astro.redirect('/login?next=%2Fmanagement%2Fdatabase-backup');
if (actor.role !== 'SYS_ADMIN') return Astro.redirect('/forbidden');
const errorCode = Astro.url.searchParams.get('error');
const initialError = errorCode ? backupMessage(errorCode) : null;
const uploads = await readBackupUploads(Astro.request);
for (const cookie of uploads.cookies) Astro.response.headers.append('Set-Cookie', cookie);
if (uploads.current?.settings.transport === 'cos')
  Astro.csp?.insertDirective(`connect-src ${uploads.current.settings.upload_origin}`);
---

<ManagementLayout
  title="数据备份 | HeyBlog"
  heading="数据备份"
  currentPath={Astro.url.pathname}
  identity={{ displayName: actor.display_name, email: actor.email ?? '', roleLabel: actor.role }}
  navigation={[...managementNavigation(actor)]}
>
  <BackupManager client:load {initialError} initialUploads={uploads.current} />
</ManagementLayout>
