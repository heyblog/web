---
import { managementNavigation } from '@/application/management/navigation';
import { authorizationError } from '@/application/management/users.messages';
import { roleLabels, usersListPath, usersQuery } from '@/application/management/users.model';
import { loadUsersPage } from '@/application/management/users-page.server';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import { buttonClass } from '@/components/management/users/users.styles';
import UsersFilters from '@/components/management/users/UsersFilters.astro';
import UsersList from '@/components/management/users/UsersList.astro';
import ManagementLayout from '@/layouts/ManagementLayout.astro';

export const prerender = false;
const result = await loadUsersPage(Astro.request, Astro.locals.sessionUser);
if (result.kind === 'redirect') {
  const headers = new Headers(result.headers);
  headers.set('Location', result.location);
  return new Response(null, { status: 302, headers });
}
for (const [name, value] of result.headers) {
  if (name !== 'set-cookie') Astro.response.headers.set(name, value);
}
for (const cookie of result.headers.getSetCookie())
  Astro.response.headers.append('Set-Cookie', cookie);
if (result.kind === 'error') Astro.response.status = result.status;
const actor = result.actor;
const query = usersQuery(Astro.url.searchParams);
const list = {
  q: query.get('q') ?? '',
  role: query.get('role') ?? '',
  status: query.get('status') ?? '',
  users: result.kind === 'ready' ? result.users : [],
  total: result.kind === 'ready' ? result.total : 0,
  page: result.kind === 'ready' ? result.page : 1,
  pages: result.kind === 'ready' ? Math.max(1, Math.ceil(result.total / result.page_size)) : 1,
};
const listQuery = new URLSearchParams({
  q: list.q,
  role: list.role,
  status: list.status,
  page: String(list.page),
});
const returnPath = usersListPath(listQuery);
const pagePath = (page: number) =>
  usersListPath(new URLSearchParams({ ...Object.fromEntries(listQuery), page: String(page) }));
const error = Astro.url.searchParams.get('error');
---

<ManagementLayout
  title="用户管理 | HeyBlog"
  heading="用户管理"
  currentPath={Astro.url.pathname}
  identity={
    actor
      ? {
          displayName: actor.display_name,
          email: actor.email ?? '',
          roleLabel: roleLabels[actor.role],
        }
      : undefined
  }
  navigation={actor ? [...managementNavigation(actor)] : []}
>
  {result.kind === 'error' ? (
    <section class="rounded-md border border-line bg-surface p-6">
      <h2 class="text-lg font-semibold">暂时无法加载用户</h2>
      <p class="mt-2 mb-5 text-sm text-fg-muted">授权服务暂时不可用，请稍后重试。</p>
      <a class={buttonClass} href={Astro.url.pathname + Astro.url.search}>
        重新加载
      </a>
    </section>
  ) : (
    <>
      <AuthNotice message={error ? authorizationError(error) : null} />
      <AuthNotice
        message={Astro.url.searchParams.get('status') === 'updated' ? '授权已更新。' : null}
        kind="success"
      />
      <div class="mb-6 flex justify-end">
        <a class={buttonClass} href="/management/users/new">
          创建用户
        </a>
      </div>
      <UsersFilters q={list.q} role={list.role} status={list.status} />
      <div class="mb-3 flex min-h-10 flex-wrap items-center justify-between gap-3 text-sm">
        <p class="text-fg-muted">
          共 <span class="font-medium text-fg">{list.total}</span> 位用户
        </p>
        {(list.q || list.role || list.status) && (
          <a
            class="inline-flex min-h-11 items-center text-tint-fg hover:underline sm:min-h-10"
            href="/management/users"
          >
            清除筛选
          </a>
        )}
      </div>
      {list.users.length ? (
        <UsersList users={list.users} actorId={result.actor.id} {returnPath} />
      ) : (
        <section class="rounded-md border border-dashed border-line py-12 text-center">
          <h2 class="text-sm font-semibold">
            {list.q || list.role || list.status ? '没有符合条件的用户' : '暂无用户'}
          </h2>
          {(list.q || list.role || list.status) && (
            <p class="mt-2 text-sm text-fg-muted">调整搜索内容或清除筛选后再试。</p>
          )}
        </section>
      )}
      {list.total > 20 && (
        <nav class="mt-6 flex flex-wrap items-center justify-between gap-3" aria-label="用户分页">
          {list.page > 1 ? (
            <a class={buttonClass} href={pagePath(list.page - 1)}>
              上一页
            </a>
          ) : (
            <span class={`${buttonClass} pointer-events-none opacity-50`} aria-disabled="true">
              上一页
            </span>
          )}
          <span class="text-sm text-fg-muted">
            第 {list.page} / {list.pages} 页
          </span>
          {list.page < list.pages ? (
            <a class={buttonClass} href={pagePath(list.page + 1)}>
              下一页
            </a>
          ) : (
            <span class={`${buttonClass} pointer-events-none opacity-50`} aria-disabled="true">
              下一页
            </span>
          )}
        </nav>
      )}
    </>
  )}
</ManagementLayout>
