---
import { requestAuthAPI } from '@/api/auth/auth.server';
import { parseClaim, parseOwnership } from '@/api/site-management/claims.types';
import { managementNavigation } from '@/application/management/navigation';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import ClaimReview from '@/components/site-management/ClaimReview.svelte';
import ManagementLayout from '@/layouts/ManagementLayout.astro';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = Astro.locals.sessionUser;
if (!user)
  return Astro.redirect('/login?next=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
if (!(
  user.role === 'SYS_ADMIN' ||
  (user.role === 'ADMIN' && user.permissions.includes('site_audit.review'))
))
  return Astro.redirect('/forbidden');
const response = await requestAuthAPI(
  Astro.request,
  `/api/web/management/site-claims/${Astro.params.claimId ?? ''}`,
);
if (response.status === 404) return Astro.redirect('/management/site-claims');
const claim = response.ok ? parseClaim(await response.json()) : null;
const ownerResponse = claim
  ? await requestAuthAPI(Astro.request, `/api/web/management/site-ownership/${claim.short_id}`)
  : null;
const ownership = ownerResponse?.ok ? parseOwnership(await ownerResponse.json()) : null;
---

<ManagementLayout
  title="认证审核详情"
  heading="认证审核详情"
  currentPath={Astro.url.pathname}
  identity={{ displayName: user.display_name, email: user.email ?? '', roleLabel: user.role }}
  navigation={[...managementNavigation(user)]}
>
  <AuthNotice message={claim ? null : '认证申请暂时无法加载，请刷新重试。'} />
  {claim && <ClaimReview client:load initial={claim} {ownership} reviewerId={user.id} />}
</ManagementLayout>
