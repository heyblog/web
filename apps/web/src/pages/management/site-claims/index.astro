---
import { requestAuthAPI } from '@/api/auth/auth.server';
import { parseClaimPage } from '@/api/site-management/claims.types';
import { managementNavigation } from '@/application/management/navigation';
import { claimListQuery } from '@/application/site-management/claims-query';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import ClaimList from '@/components/site-management/ClaimList.astro';
import ManagementLayout from '@/layouts/ManagementLayout.astro';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = Astro.locals.sessionUser;
if (!user)
  return Astro.redirect('/login?next=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
if (!(
  user.role === 'SYS_ADMIN' ||
  (user.role === 'ADMIN' && user.permissions.includes('site_audit.review'))
))
  return Astro.redirect('/forbidden');
const { page, query } = claimListQuery(Astro.url.searchParams, { management: true });
const response = await requestAuthAPI(Astro.request, `/api/web/management/site-claims?${query}`);
const data = response.ok ? parseClaimPage(await response.json()) : null;
---

<ManagementLayout
  title="站点认证审核"
  heading="站点认证审核"
  currentPath={Astro.url.pathname}
  identity={{ displayName: user.display_name, email: user.email ?? '', roleLabel: user.role }}
  navigation={[...managementNavigation(user)]}
>
  <AuthNotice message={response.ok ? null : '认证申请暂时无法加载，请刷新重试。'} />
  {data && <ClaimList {data} {page} {query} management />}
</ManagementLayout>
