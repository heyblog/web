---
import { completeOAuth } from '@/application/auth/oauth.server';
import OAuthCallbackPage from '@/components/auth/OAuthCallbackPage.astro';

export const prerender = false;
const completion = await completeOAuth(Astro.request, 'github');
if (completion instanceof Response) return completion;
for (const [name, value] of completion.headers)
  if (name !== 'set-cookie') Astro.response.headers.set(name, value);
for (const cookie of completion.headers.getSetCookie())
  Astro.response.headers.append('Set-Cookie', cookie);
---

<OAuthCallbackPage result={completion.result} />
