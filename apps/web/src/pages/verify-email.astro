---
import { IconMailCheck } from '@tabler/icons-svelte';

import { authErrorField } from '@/application/auth/auth-fields';
import { authErrorMessage, authStatusMessage } from '@/application/auth/auth-page';
import AuthField from '@/components/auth/AuthField.astro';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const email = Astro.url.searchParams.get('email')?.trim() ?? '';
---

<AuthLayout
  title="验证邮箱 | HeyBlog"
  heading="验证邮箱"
  description="输入邮件中的六位验证码，10 分钟内有效。"
>
  <AuthNotice
    message={
      authErrorField(Astro.url.searchParams.get('error'))
        ? null
        : authErrorMessage(Astro.url.searchParams.get('error'))
    }
  />
  <AuthNotice message={authStatusMessage(Astro.url.searchParams.get('status'))} kind="success" />
  <form class="grid gap-4" method="post" action="/api/web/auth/verify-email" data-field-feedback>
    <AuthField name="email" label="邮箱" autocomplete="email" type="email" value={email} />
    <AuthField
      name="code"
      label="验证码"
      autocomplete="one-time-code"
      inputmode="numeric"
      pattern="[0-9]{6}"
      maxlength={6}
      formatMessage="验证码需为 6 位数字。"
      help="填写邮件中的 6 位数字验证码。"
    />
    <button
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
      type="submit"
    >
      <IconMailCheck size={18} stroke={1.8} aria-hidden="true" />
      完成验证
    </button>
  </form>
  <form class="mt-4" method="post" action="/api/web/auth/resend-verification">
    <input type="hidden" name="email" value={email} />
    <button
      class="min-h-11 w-full rounded-sm border border-line-strong text-sm font-medium hover:bg-subtle"
      type="submit"
    >
      重新发送验证码
    </button>
  </form>
</AuthLayout>
