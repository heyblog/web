---
import { IconMailCheck } from '@tabler/icons-svelte';

import { authErrorMessage, authStatusMessage } from '@/application/auth/auth-page';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const email = Astro.url.searchParams.get('email')?.trim() ?? '';
---

<AuthLayout title="验证邮箱 | HeyBlog" heading="验证邮箱" description="输入邮件中的六位验证码。">
  <AuthNotice message={authErrorMessage(Astro.url.searchParams.get('error'))} />
  <AuthNotice message={authStatusMessage(Astro.url.searchParams.get('status'))} kind="success" />
  <form class="grid gap-4" method="post" action="/auth/verify-email">
    <label class="grid gap-1.5 text-sm font-medium"
      >邮箱<input
        class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
        name="email"
        value={email}
        type="email"
        autocomplete="email"
        required
      /></label
    >
    <label class="grid gap-1.5 text-sm font-medium"
      >验证码<input
        class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 font-mono text-lg outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
        name="code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        required
      /></label
    >
    <button
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
      type="submit"><IconMailCheck size={18} stroke={1.8} aria-hidden="true" />完成验证</button
    >
  </form>
  <form class="mt-4" method="post" action="/auth/resend-verification">
    <input type="hidden" name="email" value={email} /><button
      class="min-h-11 w-full rounded-sm border border-line-strong text-sm font-medium hover:bg-subtle"
      type="submit">重新发送验证码</button
    >
  </form>
</AuthLayout>
