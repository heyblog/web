---
import { IconArrowLeft, IconExternalLink } from '@tabler/icons-svelte';

import { loadPublicAnnouncement } from '@/api/announcements/announcements.server';
import { isUUID } from '@/api/announcements/announcements.types';
import AnnouncementInline from '@/components/announcements/AnnouncementInline.svelte';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { contentDescription } from '@/shared/content/description';
import { articleStructuredData, breadcrumbStructuredData } from '@/shared/structured-data';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Astro.params.id ?? '';
const result = isUUID(id)
  ? await loadPublicAnnouncement(Astro.request, id)
  : { kind: 'not-found' as const };
const announcement = result.kind === 'success' ? result.data : null;
const announcementPath = `/announcements/${(announcement?.id ?? id).toLowerCase()}`;
if (!announcement) {
  Astro.response.status = result.kind === 'not-found' ? 404 : 503;
  if (Astro.response.status === 503) Astro.response.headers.set('Retry-After', '30');
}
const description = contentDescription(
  announcement?.bodyMarkdown ?? undefined,
  announcement?.title ?? 'HeyBlog 站点公告',
);
const publishedTime = announcement
  ? new Date(
      Math.max(Date.parse(announcement.startsAt), Date.parse(announcement.publishedAt)),
    ).toISOString()
  : undefined;
const modifiedTime =
  announcement && publishedTime
    ? new Date(
        Math.max(Date.parse(publishedTime), Date.parse(announcement.updatedAt)),
      ).toISOString()
    : undefined;
---

<PublicLayout
  title={`${announcement?.title ?? '公告'} | HeyBlog`}
  canonicalPath={announcementPath}
  ogType="article"
  {description}
  {publishedTime}
  {modifiedTime}
  structuredData={
    announcement
      ? [
          articleStructuredData({
            title: announcement.title,
            description,
            path: announcementPath,
            publishedTime,
            modifiedTime,
          }),
          breadcrumbStructuredData([
            { name: '首页', path: '/' },
            { name: '公告', path: '/announcements' },
            { name: announcement.title, path: announcementPath },
          ]),
        ]
      : undefined
  }
  robots={announcement ? undefined : 'noindex, nofollow'}
>
  <div class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-8 sm:py-16">
    <a
      class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm text-tint-fg"
      href="/announcements"
    >
      <IconArrowLeft size={16} aria-hidden="true" />
      全部公告
    </a>
    {announcement ? (
      <article>
        <header class="border-b border-line pb-6">
          <time class="font-mono text-xs text-fg-muted" datetime={announcement.startsAt}>
            {new Date(announcement.startsAt).toLocaleDateString('zh-CN', {
              timeZone: 'Asia/Shanghai',
            })}
          </time>
          <h1 class="mt-3 text-3xl/tight font-bold wrap-anywhere">{announcement.title}</h1>
        </header>
        {announcement.bodyMarkdown ? (
          <div class="py-8 leading-7">
            <AnnouncementInline source={announcement.bodyMarkdown} />
          </div>
        ) : null}
        {announcement.action ? (
          <a
            class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-fg hover:bg-primary-hover"
            href={announcement.action.href}
            rel={announcement.action.external ? 'noopener noreferrer' : undefined}
            target={announcement.action.external ? '_blank' : undefined}
          >
            {announcement.action.label}
            {announcement.action.external ? (
              <IconExternalLink size={16} aria-hidden="true" />
            ) : null}
          </a>
        ) : null}
      </article>
    ) : (
      <div role="alert">
        <h1 class="text-2xl font-semibold">
          {result.kind === 'not-found' ? '公告不存在' : '公告暂时无法加载'}
        </h1>
        {result.kind !== 'not-found' ? (
          <a class="mt-4 inline-flex min-h-11 items-center text-tint-fg" href={Astro.url.pathname}>
            重新加载
          </a>
        ) : null}
      </div>
    )}
  </div>
</PublicLayout>
