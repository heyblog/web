---
import { IconLogin2 } from '@tabler/icons-svelte';

import { safeNext } from '@/application/auth/auth.server';
import { authErrorField } from '@/application/auth/auth-fields';
import { authErrorMessage, authStatusMessage } from '@/application/auth/auth-page';
import { confirmationLocation } from '@/application/auth/profile-routing';
import AuthField from '@/components/auth/AuthField.astro';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import OAuthButton from '@/components/auth/OAuthButton.svelte';
import AuthLayout from '@/layouts/AuthLayout.astro';

export const prerender = false;
const next = safeNext(Astro.url.searchParams.get('next'));
Astro.response.headers.set('Cache-Control', 'private, no-store');
const user = Astro.locals.sessionUser;
if (user)
  return Astro.redirect(user.profile_confirmation_required ? confirmationLocation(next) : next);
const error = authErrorMessage(Astro.url.searchParams.get('error'));
const status = authStatusMessage(Astro.url.searchParams.get('status'));
---

<AuthLayout title="登录 | HeyBlog" heading="登录" description="使用 HeyBlog 账号或第三方账号继续。">
  <AuthNotice message={authErrorField(Astro.url.searchParams.get('error')) ? null : error} />
  <AuthNotice message={status} kind="success" />
  <form class="grid gap-4" method="post" action="/api/web/auth/login" data-field-feedback>
    <input type="hidden" name="next" value={next} />
    <AuthField name="identifier" label="用户名或邮箱" autocomplete="username" />
    <AuthField name="password" label="密码" autocomplete="current-password" type="password" />
    <button
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg transition-colors hover:bg-primary-hover"
      type="submit"
    >
      <IconLogin2 size={18} stroke={1.8} aria-hidden="true" /> 登录
    </button>
  </form>
  <div class="my-5 flex items-center gap-3 text-xs text-fg-subtle before:h-px before:flex-1 before:bg-line after:h-px after:flex-1 after:bg-line">
    或
  </div>
  <div class="grid gap-3">
    <OAuthButton provider="github" {next} client:load />
    <OAuthButton provider="blogsclub" {next} client:load />
  </div>
  <nav class="mt-6 flex flex-wrap justify-between gap-3 text-sm" aria-label="账号帮助">
    <a class="text-tint-fg hover:underline" href={`/register?next=${encodeURIComponent(next)}`}>
      创建账号
    </a>
    <a class="text-tint-fg hover:underline" href="/forgot-password">
      忘记密码
    </a>
  </nav>
</AuthLayout>
