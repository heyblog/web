---
import { IconMailForward } from '@tabler/icons-svelte';

import { authErrorMessage, authStatusMessage } from '@/application/auth/auth-page';
import AuthNotice from '@/components/auth/AuthNotice.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
export const prerender = false;
const status = Astro.url.searchParams.get('status');
const resetSent = status === 'reset-sent';
---

<AuthLayout
  title="找回密码 | HeyBlog"
  heading="找回密码"
  description="我们会向可用账号发送一次性重置链接。"
>
  <AuthNotice message={authErrorMessage(Astro.url.searchParams.get('error'))} />
  <AuthNotice message={resetSent ? null : authStatusMessage(status)} kind="success" />
  {
    resetSent ? (
      <AuthNotice kind="success">
        <span class="inline-flex flex-wrap">
          <span class="whitespace-nowrap">如果该邮箱对应可用账号，</span>
          <span class="whitespace-nowrap">重置链接已发送，</span>
          <span class="whitespace-nowrap">有效期为 30 分钟。</span>
        </span>
      </AuthNotice>
    ) : null
  }
  <form class="grid gap-4" method="post" action="/auth/password/forgot">
    <label class="grid gap-1.5 text-sm font-medium"
      >邮箱<input
        class="min-h-11 rounded-sm border border-line-strong bg-surface px-3 text-base outline-none focus:border-focus focus:ring-2 focus:ring-focus/20"
        name="email"
        type="email"
        autocomplete="email"
        required
      /></label
    >
    <button
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-sm bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover"
      type="submit"
      ><IconMailForward size={18} stroke={1.8} aria-hidden="true" />发送重置链接</button
    >
  </form>
  <p class="mt-6 text-center text-sm">
    <a class="text-tint-fg hover:underline" href="/login">返回登录</a>
  </p>
</AuthLayout>
