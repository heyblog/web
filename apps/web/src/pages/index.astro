---
import { loadHome } from '@/application/home/home.server';
import { readMemberDirectory } from '@/application/static-content/static-content.server';
import HomeAnnouncement from '@/components/home/HomeAnnouncement.astro';
import HomeCommunity from '@/components/home/HomeCommunity.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeSites from '@/components/home/HomeSites.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';

export const prerender = false;

const [homeResult, memberDirectory] = await Promise.all([
  loadHome(Astro.request.signal),
  readMemberDirectory(),
]);
const home = homeResult.kind === 'success' ? homeResult.data : null;
const activeMemberCount = memberDirectory.current.filter(
  (member) => member.status === 'ACTIVE',
).length;

Astro.response.headers.set('Cache-Control', 'no-store');
if (homeResult.kind !== 'success') {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}
---

<PublicLayout>
  <div class="mx-auto w-[min(calc(100%-2rem),80rem)] sm:w-[min(calc(100%-3rem),80rem)]">
    <HomeHero siteCount={home?.siteCount ?? null} />
    {
      home?.announcement ? (
        <div class="pt-8">
          <HomeAnnouncement announcement={home.announcement} />
        </div>
      ) : null
    }
    <HomeSites sites={home?.sites ?? []} unavailable={home === null} />
    <HomeCommunity {activeMemberCount} />
  </div>
</PublicLayout>
