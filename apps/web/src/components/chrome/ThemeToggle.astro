---
import { IconMoon, IconSun } from '@tabler/icons-svelte';
---

<button
  class="relative inline-flex size-11 cursor-pointer appearance-none items-center justify-center rounded-md border border-line-strong bg-surface p-0 text-fg-muted transition-[border-color,background-color,color,scale] duration-[var(--motion-color),var(--motion-color),var(--motion-color),var(--motion-fast)] ease-standard hover:border-primary hover:bg-tint hover:text-tint-fg active:scale-96 sm:size-10"
  type="button"
  data-theme-toggle
  aria-label="切换为深色模式"
  aria-pressed="false"
>
  <IconSun
    class="absolute transition-[opacity,transform] duration-(--motion-base) ease-out motion-reduce:transform-none motion-reduce:transition-opacity motion-reduce:duration-150 dark:scale-96 dark:-rotate-24 dark:opacity-0"
    data-theme-icon="sun"
    aria-hidden="true"
    size={18}
    stroke={1.75}
  />
  <IconMoon
    class="absolute scale-96 -rotate-24 opacity-0 transition-[opacity,transform] duration-(--motion-base) ease-out motion-reduce:transform-none motion-reduce:transition-opacity motion-reduce:duration-150 dark:scale-100 dark:rotate-0 dark:opacity-100"
    data-theme-icon="moon"
    aria-hidden="true"
    size={18}
    stroke={1.75}
  />
</button>
