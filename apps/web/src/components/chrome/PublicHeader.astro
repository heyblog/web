---
import {
  activeNavigationHref,
  navigationPath,
  navigationRankClasses,
  sortNavigation,
} from '@/shared/public-header.shared';
import { siteConfig } from '@/site.config';

import PublicAccountEntry from './PublicAccountEntry.astro';
import PublicNavigationMenu from './PublicNavigationMenu.astro';
import PublicSiteActions from './PublicSiteActions.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const isHome = currentPath === '/';
const primary = sortNavigation(siteConfig.navigation.primary);
const submission = siteConfig.navigation.submission.primary;
const submissionItems = sortNavigation(siteConfig.navigation.submission.menu);
const activeHref = activeNavigationHref([...primary, submission, ...submissionItems], currentPath);
const navigationLinkClass =
  "relative min-h-16 items-center justify-center px-3 text-sm font-medium whitespace-nowrap transition-colors duration-(--motion-color) hover:text-fg after:absolute after:inset-x-3 after:-bottom-px after:h-0.5 after:scale-x-50 after:bg-primary after:opacity-0 after:transition-[opacity,scale] after:duration-(--motion-base) after:ease-standard after:content-[''] after:motion-reduce:transition-none";
---

<header
  class="sticky top-0 z-30 border-b border-line bg-canvas/88 backdrop-blur-md"
  data-page-header
  data-public-header
  data-home={isHome ? 'true' : 'false'}
>
  <div
    class="mx-auto flex min-h-16 w-[min(calc(100%-0.5rem),80rem)] items-center gap-0 xs:w-[min(calc(100%-2rem),80rem)] xs:gap-2 sm:w-[min(calc(100%-3rem),80rem)] sm:gap-3"
  >
    <a
      class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-sm text-sm font-semibold xs:text-base sm:min-h-10 sm:min-w-10"
      href="/"
      aria-label={`${siteConfig.name} 首页`}
    >
      <img
        class="size-9 max-w-none shrink-0 rounded-md"
        src="/favicon.svg"
        alt=""
        width="40"
        height="40"
      />
      <span
        class="ml-2 max-w-0 min-w-0 overflow-hidden opacity-0 transition-[max-width,opacity] duration-(--motion-base) ease-standard motion-reduce:transition-none xs:data-[visible=true]:max-w-18 xs:data-[visible=true]:opacity-100"
        data-public-brand
        data-visible={isHome ? 'false' : 'true'}
        aria-hidden="true"
        ><span class="block min-w-18 pl-1.5 whitespace-nowrap">{siteConfig.name}</span></span
      >
    </a>
    <nav class="contents" aria-label="主导航">
      {
        primary.map((item, index) => (
          <a
            class:list={[
              navigationLinkClass,
              navigationRankClasses[index]?.direct ?? 'hidden',
              activeHref === item.href
                ? 'text-fg after:scale-x-100 after:opacity-100'
                : 'text-fg-muted',
            ]}
            href={item.href}
            data-astro-prefetch={item.prefetch === false ? 'false' : undefined}
            aria-current={
              navigationPath(currentPath) === navigationPath(item.href) ? 'page' : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
      <PublicNavigationMenu items={primary} {activeHref} {currentPath} />
    </nav>
    <div
      class="order-1 ml-auto flex shrink-0 items-center sm:order-0 sm:gap-1"
      role="group"
      aria-label="站点操作"
    >
      <ThemeToggle />
      <PublicSiteActions primary={submission} items={submissionItems} {activeHref} {currentPath} />
      <PublicAccountEntry server:defer>
        <PublicAccountEntry slot="fallback" hasSession={false} />
      </PublicAccountEntry>
    </div>
  </div>
</header>

<script>
  import { initPublicHeader } from '@/shared/public-header.browser';
  initPublicHeader();
</script>
