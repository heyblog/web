---
import { IconMenu2, IconX } from '@tabler/icons-svelte';

import { siteConfig } from '@/site.config';

import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizePath = (value: string) =>
  value.length > 1 && value.endsWith('/') ? value.slice(0, -1) : value || '/';
const activePath = normalizePath(currentPath);
const isActive = (href: string, match: 'exact' | 'prefix') => {
  const target = normalizePath(href);

  return match === 'exact'
    ? activePath === target
    : activePath === target || activePath.startsWith(`${target}/`);
};
---

<header class="site-header" data-public-header>
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label={`${siteConfig.name} 首页`}>
      <img class="site-brand-logo" src="/favicon.svg" alt="" width="40" height="40" />
      <span>{siteConfig.name}</span>
    </a>

    <nav class="desktop-navigation" aria-label="主导航">
      {
        siteConfig.navigation.map((item) => (
          <a
            class:list={[
              'navigation-link',
              { 'navigation-link-active': isActive(item.href, item.match) },
            ]}
            href={item.href}
            aria-current={isActive(item.href, item.match) ? 'page' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
            target={item.external ? '_blank' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-actions">
      <ThemeToggle />
      <details class="mobile-navigation" data-public-menu data-details-state="closed">
        <summary
          class="icon-button mobile-navigation-trigger"
          aria-label="打开导航"
          aria-expanded="false"
        >
          <IconMenu2
            class="mobile-navigation-menu-icon"
            aria-hidden="true"
            size={19}
            stroke={1.75}
          />
          <IconX class="mobile-navigation-close-icon" aria-hidden="true" size={19} stroke={1.75} />
        </summary>
        <nav class="mobile-navigation-panel" aria-label="移动端主导航">
          {
            siteConfig.navigation.map((item) => (
              <a
                class:list={[
                  'mobile-navigation-link',
                  { 'mobile-navigation-link-active': isActive(item.href, item.match) },
                ]}
                href={item.href}
                aria-current={isActive(item.href, item.match) ? 'page' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
                target={item.external ? '_blank' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import {
    type AnimatedDetailsController,
    setupAnimatedDetails,
  } from '@/shared/animated-details.browser';

  const menuControllers = new WeakMap<HTMLDetailsElement, AnimatedDetailsController>();

  document.querySelectorAll<HTMLDetailsElement>('[data-public-menu]').forEach((menu) => {
    const panel = menu.querySelector<HTMLElement>('.mobile-navigation-panel');
    const trigger = menu.querySelector<HTMLElement>(':scope > summary');

    if (!panel || !trigger) {
      return;
    }

    const controller = setupAnimatedDetails(menu, {
      panel,
      onExpandedChange: (expanded) => {
        trigger.setAttribute('aria-label', expanded ? '关闭导航' : '打开导航');
      },
    });
    menuControllers.set(menu, controller);
  });

  const closeMenu = (menu: HTMLDetailsElement, restoreFocus = false) => {
    menuControllers.get(menu)?.close({ restoreFocus });
  };

  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-public-menu][open]').forEach((menu) => {
      if (!menu.contains(target) || target.closest('a')) {
        closeMenu(menu);
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return;
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-public-menu][open]').forEach((menu) => {
      closeMenu(menu, true);
    });
  });
</script>
