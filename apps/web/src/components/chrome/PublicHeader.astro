---
import { IconMenu2, IconX } from '@tabler/icons-svelte';

import { siteConfig } from '@/site.config';

import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizePath = (value: string) =>
  value.length > 1 && value.endsWith('/') ? value.slice(0, -1) : value || '/';
const activePath = normalizePath(currentPath);
const isActive = (href: string, match: 'exact' | 'prefix') => {
  const target = normalizePath(href);

  return match === 'exact'
    ? activePath === target
    : activePath === target || activePath.startsWith(`${target}/`);
};
---

<header class="site-header" data-public-header>
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label={`${siteConfig.name} 首页`}>
      <img class="site-brand-logo" src="/favicon.svg" alt="" width="40" height="40" />
      <span>{siteConfig.name}</span>
    </a>

    <nav class="desktop-navigation" aria-label="主导航">
      {
        siteConfig.navigation.map((item) => (
          <a
            class:list={[
              'navigation-link',
              { 'navigation-link-active': isActive(item.href, item.match) },
            ]}
            href={item.href}
            aria-current={isActive(item.href, item.match) ? 'page' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
            target={item.external ? '_blank' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-actions">
      <ThemeToggle />
      <details class="mobile-navigation" data-public-menu>
        <summary
          class="icon-button mobile-navigation-trigger"
          aria-label="打开导航"
          aria-expanded="false"
        >
          <IconMenu2
            class="mobile-navigation-menu-icon"
            aria-hidden="true"
            size={19}
            stroke={1.75}
          />
          <IconX class="mobile-navigation-close-icon" aria-hidden="true" size={19} stroke={1.75} />
        </summary>
        <nav class="mobile-navigation-panel" aria-label="移动端主导航">
          {
            siteConfig.navigation.map((item) => (
              <a
                class:list={[
                  'mobile-navigation-link',
                  { 'mobile-navigation-link-active': isActive(item.href, item.match) },
                ]}
                href={item.href}
                aria-current={isActive(item.href, item.match) ? 'page' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
                target={item.external ? '_blank' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  declare global {
    interface Window {
      __heyblogPublicHeaderReady?: boolean;
    }
  }

  const closeMenu = (menu: HTMLDetailsElement, restoreFocus = false) => {
    if (!menu.open) {
      return;
    }

    menu.open = false;
    const trigger = menu.querySelector<HTMLElement>('summary');
    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.setAttribute('aria-label', '打开导航');

    if (restoreFocus) {
      trigger?.focus();
    }
  };

  const syncMenu = (menu: HTMLDetailsElement) => {
    const trigger = menu.querySelector<HTMLElement>('summary');
    trigger?.setAttribute('aria-expanded', String(menu.open));
    trigger?.setAttribute('aria-label', menu.open ? '关闭导航' : '打开导航');
  };

  if (!window.__heyblogPublicHeaderReady) {
    window.__heyblogPublicHeaderReady = true;

    document.addEventListener(
      'toggle',
      (event) => {
        const menu = event.target;

        if (menu instanceof HTMLDetailsElement && menu.matches('[data-public-menu]')) {
          syncMenu(menu);
        }
      },
      true,
    );

    document.addEventListener('click', (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      document.querySelectorAll<HTMLDetailsElement>('[data-public-menu][open]').forEach((menu) => {
        if (!menu.contains(target) || target.closest('a')) {
          closeMenu(menu);
        }
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') {
        return;
      }

      document.querySelectorAll<HTMLDetailsElement>('[data-public-menu][open]').forEach((menu) => {
        closeMenu(menu, true);
      });
    });
  }
</script>
