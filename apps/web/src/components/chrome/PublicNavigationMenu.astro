---
import { IconChevronDown, IconMenu2, IconPlus } from '@tabler/icons-svelte';

import { navigationRankClasses } from '@/shared/public-header.shared';
import type { SiteNavigationItem } from '@/site-config.types';

interface Props {
  items: readonly SiteNavigationItem[];
  activeHref?: string;
  currentPath: string;
  variant: 'overflow' | 'submission';
}
const { items, activeHref, currentPath, variant } = Astro.props;
const overflow = variant === 'overflow';
const label = overflow ? '更多导航' : '提交博客';
const panelId = `public-${variant}-panel`;
const activeIndex = items.findIndex((item) => item.href === activeHref);
const active = activeIndex >= 0;
const activeTriggerClasses = overflow
  ? [
      'text-fg after:opacity-100 sm:text-fg-muted sm:after:opacity-0',
      'text-fg after:opacity-100 md:text-fg-muted md:after:opacity-0',
      'text-fg after:opacity-100',
    ][activeIndex]
  : 'text-fg after:opacity-100';
const triggerClass =
  "relative inline-flex min-h-16 min-w-11 cursor-pointer list-none items-center justify-center gap-1.5 px-2 text-sm font-medium whitespace-nowrap transition-colors duration-(--motion-color) hover:text-fg after:absolute after:inset-x-2 after:-bottom-px after:h-0.5 after:bg-primary after:opacity-0 after:content-[''] sm:min-w-10 sm:px-3 sm:after:inset-x-3 [&::-webkit-details-marker]:hidden";
---

<details class:list={['group static xs:relative', overflow && 'lg:hidden']} data-public-menu>
  <summary
    class:list={[triggerClass, active ? activeTriggerClasses : 'text-fg-muted']}
    data-public-menu-trigger
    aria-label={label}
    title={label}
    aria-controls={panelId}
  >
    {
      overflow ? (
        <IconMenu2 class="xs:hidden" size={18} stroke={1.8} aria-hidden="true" />
      ) : (
        <IconPlus class="xs:hidden" size={18} stroke={1.8} aria-hidden="true" />
      )
    }
    <span class="hidden xs:inline">{overflow ? '更多' : label}</span>
    <IconChevronDown
      class="hidden transition-transform duration-(--motion-base) group-open:rotate-180 motion-reduce:transform-none xs:block"
      size={16}
      stroke={1.8}
      aria-hidden="true"
    />
  </summary>
  <div
    id={panelId}
    data-public-menu-panel
    class:list={[
      'absolute inset-x-0 top-full z-40 max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-b border-line bg-surface p-4 shadow-sm transition-[translate,scale,opacity] duration-(--motion-base) ease-out group-data-[details-state=closed]:pointer-events-none group-data-[details-state=closed]:-translate-y-1 group-data-[details-state=closed]:scale-97 group-data-[details-state=closed]:opacity-0 group-data-[details-state=closed]:duration-(--motion-fast) motion-reduce:translate-none! motion-reduce:scale-100! motion-reduce:transition-opacity motion-reduce:duration-(--motion-fast) xs:inset-x-auto xs:mt-2 xs:w-52 xs:rounded-md xs:border xs:p-1',
      overflow ? 'origin-top-left xs:left-0' : 'origin-top-right xs:right-0',
    ]}
  >
    <ul class="m-0 grid list-none gap-1 p-0" aria-label={label}>
      {
        items.map((item, index) => (
          <li class={overflow ? navigationRankClasses[index]?.overflow : undefined}>
            <a
              class:list={[
                'flex min-h-11 items-center rounded-sm px-3 py-2 text-sm font-medium wrap-anywhere transition-colors duration-(--motion-color) hover:bg-subtle hover:text-fg focus-visible:bg-subtle sm:min-h-10',
                activeHref === item.href ? 'bg-tint text-tint-fg' : 'text-fg-muted',
              ]}
              href={item.href}
              aria-current={currentPath.replace(/\/+$/u, '') === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>
