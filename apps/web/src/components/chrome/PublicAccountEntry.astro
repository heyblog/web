---
import { IconUser } from '@tabler/icons-svelte';

import { resolvePublicAccountEntry } from '@/shared/public-header.shared';

interface Props {
  hasSession?: boolean;
}

const deferred = Astro.props.hasSession === undefined;
const { hasSession = Astro.cookies.has('heyblog_access_token') } = Astro.props;
const entry = resolvePublicAccountEntry(hasSession);
const entryClass =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-md px-2 text-sm font-medium text-fg-muted transition-colors duration-(--motion-color) hover:bg-subtle hover:text-fg sm:min-h-10 sm:min-w-10 sm:px-3';

if (deferred) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
---

<a class={entryClass} href={entry.href} aria-label={entry.label} title={entry.label}>
  <IconUser class="xs:hidden" size={18} stroke={1.8} aria-hidden="true" />
  <span class="hidden xs:inline">{entry.label}</span>
</a>
