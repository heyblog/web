---
import { IconExternalLink } from '@tabler/icons-svelte';

import { siteConfig } from '@/site.config';

import BuildInfo from './BuildInfo.astro';

const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear === siteConfig.footer.copyrightStartYear
    ? `${currentYear}`
    : `${siteConfig.footer.copyrightStartYear} - ${currentYear}`;
---

<footer class="border-t border-line">
  <div class="mx-auto grid w-[min(calc(100%-2rem),80rem)] grid-cols-2 gap-5 py-6 text-sm text-fg-muted sm:w-[min(calc(100%-3rem),80rem)] sm:gap-x-12 sm:gap-y-8 sm:py-8 md:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,1fr))]">
    <section class="col-span-2 min-w-0 md:col-span-1" aria-labelledby="footer-site-info">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs sm:grid sm:gap-2 sm:text-sm">
        <a
          class="inline-flex min-h-10 min-w-0 items-center gap-1.5 transition-colors duration-(--motion-color) ease-standard hover:text-tint-fg sm:min-h-10"
          href={siteConfig.footer.registration.href}
          rel="noreferrer"
          target="_blank"
        >
          <span>{siteConfig.footer.registration.label}</span>
          <IconExternalLink aria-hidden="true" size={13} stroke={1.75} />
        </a>
        <p class="m-0">
          Copyright © {copyrightYears} {siteConfig.footer.copyrightOwner}
        </p>
        <BuildInfo />
      </div>
    </section>

    <nav class="min-w-0" aria-labelledby="footer-statements">
      <h2 class="mb-2 font-mono text-xs font-semibold text-fg sm:mb-4" id="footer-statements">
        站点声明
      </h2>
      <ul class="m-0 grid list-none gap-0 p-0">
        {siteConfig.footer.statementLinks.map((item) => (
          <li>
            <a
              class="inline-flex min-h-10 max-w-full items-center gap-1.5 wrap-break-word transition-colors duration-(--motion-color) ease-standard hover:text-tint-fg sm:min-h-10"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="min-w-0" aria-labelledby="footer-friend-links">
      <h2 class="mb-2 font-mono text-xs font-semibold text-fg sm:mb-4" id="footer-friend-links">
        友情链接
      </h2>
      <ul class="m-0 grid list-none gap-0 p-0">
        {siteConfig.footer.friendLinks.map((item) => (
          <li>
            <a
              class="inline-flex min-h-10 max-w-full items-center gap-1.5 wrap-break-word transition-colors duration-(--motion-color) ease-standard hover:text-tint-fg sm:min-h-10"
              href={item.href}
              rel={item.external ? 'noreferrer' : undefined}
              target={item.external ? '_blank' : undefined}
            >
              <span>{item.label}</span>
              {item.external ? (
                <IconExternalLink aria-hidden="true" size={13} stroke={1.75} />
              ) : null}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
