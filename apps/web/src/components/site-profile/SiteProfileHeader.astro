---
import { IconExternalLink } from '@tabler/icons-svelte';

import type { SiteProfile } from '@/api/sites/site-profile.types';
import { siteOgImagePath } from '@/application/site-og/site-og.metadata.server';
import { siteOutboundAttributes } from '@/application/site-outbound/site-outbound.shared';

import SiteCardPreview from './SiteCardPreview.svelte';
import SiteClickCount from './SiteClickCount.svelte';
interface Props {
  profile: SiteProfile;
}
const { profile } = Astro.props;
const cardImagePath = siteOgImagePath(profile);
const accessScopeLabels: Record<NonNullable<SiteProfile['accessScope']>, string> = {
  ALL: '全球可访问',
  CN: '仅中国大陆可访问',
  GL: '仅海外可访问',
};
const healthLabels = { OK: '访问正常', WARN: '访问不稳定', DOWN: '持续无法访问' } as const;
const shortCode = Array.from(profile.name.trim())[0]?.toUpperCase() ?? 'H';
const dateLabel = (value: string) => {
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? '日期未知'
    : date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
const badgeClass =
  'inline-flex min-h-5 items-center rounded-sm px-2 text-xs font-medium wrap-anywhere';
---

<section aria-labelledby="site-profile-title" data-site-impression={profile.shortId}>
  <div class="grid min-w-0 gap-6 sm:grid-cols-[minmax(0,1fr)_16rem] sm:items-start sm:gap-8">
    <div class="min-w-0">
      <div class="flex min-w-0 items-start gap-4">
        <span
          class="inline-flex size-12 shrink-0 items-center justify-center rounded-md bg-tint text-lg font-semibold text-tint-fg"
          aria-hidden="true"
        >
          {shortCode}
        </span>
        <div class="min-w-0">
          <h1 class="text-3xl/tight font-bold wrap-anywhere sm:text-4xl" id="site-profile-title">
            {profile.name}
          </h1>
          <p class="mt-2 font-mono text-sm wrap-anywhere text-fg-muted">{profile.host}</p>
        </div>
      </div>
      {profile.summary ? (
        <p class="mt-6 max-w-176 text-base/normal wrap-anywhere text-fg-muted">{profile.summary}</p>
      ) : null}
      <div class="mt-4 flex min-w-0 flex-wrap gap-2">
        {profile.directoryStatus === 'abnormal' ? (
          <span class:list={[badgeClass, 'bg-warning-bg text-warning-fg']}>异常状态</span>
        ) : null}
        <span class:list={[badgeClass, 'bg-tint text-tint-fg']}>
          {profile.accessScope === null ? '访问范围待检测' : accessScopeLabels[profile.accessScope]}
        </span>
        <span class:list={[badgeClass, 'bg-subtle text-fg-muted']}>
          {profile.healthStatus === null ? '健康状态待检测' : healthLabels[profile.healthStatus]}
        </span>
        {profile.classification ? (
          <span class:list={[badgeClass, 'bg-tint text-tint-fg']}>
            {profile.classification.level1.name} · {profile.classification.level2.name}
          </span>
        ) : null}
        {profile.tertiaryTags.map((topic) => (
          <span class:list={[badgeClass, 'bg-subtle text-fg-muted']}>{topic.name}</span>
        ))}
      </div>
    </div>
    <div class="grid min-w-0 gap-6">
      <SiteClickCount count={profile.metrics.clickCount} />
      <dl class="grid min-w-0 gap-3 text-sm">
        <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-3">
          <dt class="text-xs font-medium text-fg-muted">加入时间</dt>
          <dd class="font-medium wrap-anywhere">{dateLabel(profile.joinedAt)}</dd>
        </div>
        <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-3">
          <dt class="text-xs font-medium text-fg-muted">更新时间</dt>
          <dd class="font-medium wrap-anywhere">{dateLabel(profile.updatedAt)}</dd>
        </div>
        <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-3">
          <dt class="text-xs font-medium text-fg-muted">最近检测</dt>
          <dd class="font-medium wrap-anywhere">
            {profile.lastCheckedAt === null ? '尚未检测' : dateLabel(profile.lastCheckedAt)}
          </dd>
        </div>
        <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-3">
          <dt class="text-xs font-medium text-fg-muted">标识符</dt>
          <dd class="font-mono font-medium wrap-anywhere">{profile.customId ?? profile.shortId}</dd>
        </div>
      </dl>
      <a
        class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium whitespace-nowrap text-primary-fg transition-[background-color,scale] duration-(--motion-fast) hover:bg-primary-hover active:scale-96 active:bg-primary-active motion-reduce:scale-100 motion-reduce:transform-none sm:min-h-10"
        {...siteOutboundAttributes({ shortId: profile.shortId })}
      >
        访问博客
        <IconExternalLink aria-hidden="true" size={16} stroke={1.8} />
      </a>
      <a
        class="inline-flex min-h-11 items-center justify-center text-sm text-tint-fg underline underline-offset-4"
        href={`/dashboard/claims?short_id=${profile.shortId}`}
      >
        认领此站点
      </a>
      <SiteCardPreview
        client:load
        imagePath={cardImagePath}
        imageAlt={`${profile.name}的博客分享卡片`}
      />
    </div>
  </div>
</section>
