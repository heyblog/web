---
import type { PublicAnnouncement } from '@/api/announcements/announcements.types';
import { siteConfig } from '@/site.config';

import HomeAnnouncements from './HomeAnnouncements.svelte';

interface Props {
  siteCount: number | null;
  announcements: readonly PublicAnnouncement[];
}

const { siteCount, announcements } = Astro.props;
const hasAnnouncements = announcements.length > 0;
---

<section
  class:list={['border-b border-line pt-10 sm:pt-12', !hasAnnouncements && 'pb-10 sm:pb-12']}
  aria-labelledby="home-title"
  data-home-hero
>
  <div class="mx-auto grid w-full max-w-300 gap-6 px-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-8 sm:px-6">
    <div class="max-w-160 min-w-0">
      <p class="font-mono text-xs font-medium text-tint-fg">独立博客网络</p>
      <h1 class="mt-3 text-4xl/tight font-bold" id="home-title">
        {siteConfig.name}
      </h1>
      <p class="mt-4 text-base/7 text-fg-muted">{siteConfig.description}</p>
    </div>
    <aside class="flex flex-wrap gap-x-8 gap-y-4" aria-label="站点概览">
      <div class="flex flex-col gap-2">
        {siteCount === null ? (
          <p class="text-sm text-fg-muted">数据暂不可用</p>
        ) : (
          <p class="text-3xl/tight font-bold tabular-nums">{siteCount.toLocaleString('zh-CN')}</p>
        )}
        <p class="font-mono text-xs font-medium text-fg-muted">已收录博客</p>
      </div>
    </aside>
  </div>
  {hasAnnouncements && (
    <div class="mx-auto mt-8 w-full max-w-180 px-4 sm:mt-10 sm:px-6">
      <div class="border-t border-dashed border-line/70 py-6">
        <HomeAnnouncements client:load {announcements} />
      </div>
    </div>
  )}
</section>
