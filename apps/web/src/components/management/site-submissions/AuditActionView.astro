---
import type { AuditDetail } from '@/application/site-submission/site-submission.types';

import AuditDiffView from './AuditDiffView.astro';
import AuditSnapshotView from './AuditSnapshotView.astro';

interface Props {
  detail: AuditDetail;
}

const { detail } = Astro.props;
const isApproved = detail.status === 'APPROVED';
---

{
  detail.action === 'CREATE' ? (
    <div class="grid gap-6">
      <AuditSnapshotView
        snapshot={
          isApproved
            ? detail.final_snapshot
            : (detail.review_draft_snapshot ?? detail.proposed_snapshot)
        }
        title={
          isApproved
            ? '最终新增数据'
            : detail.review_draft_snapshot
              ? '计划新增的数据'
              : '申请新增的数据'
        }
      />
      {detail.diff.reviewer_correction.length > 0 ? (
        <AuditDiffView diff={detail.diff} mode="correction" />
      ) : null}
    </div>
  ) : detail.action === 'UPDATE' ? (
    <div class="grid gap-6">
      <section class="rounded-md border border-line bg-surface p-5 sm:p-6">
        <h2 class="text-lg font-bold">修改申请说明</h2>
        <p class="mt-3 text-sm whitespace-pre-wrap text-fg-muted">{detail.request_reason || '—'}</p>
      </section>
      <AuditDiffView diff={detail.diff} />
      {isApproved ? (
        <details class="rounded-md border border-line bg-surface">
          <summary class="min-h-11 cursor-pointer px-5 py-3 font-semibold">
            查看最终站点数据
          </summary>
          <div class="border-t border-line p-4">
            <AuditSnapshotView snapshot={detail.final_snapshot} title="最终写入数据" />
          </div>
        </details>
      ) : null}
    </div>
  ) : (
    <div class="grid gap-6">
      <section class="rounded-md border border-line bg-surface p-5 sm:p-6">
        <h2 class="text-lg font-bold">{detail.action === 'DELETE' ? '删除请求' : '恢复请求'}</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs text-fg-muted">请求动作</dt>
            <dd class="mt-1 font-medium">
              {detail.action === 'DELETE' ? '从目录中删除站点' : '恢复站点展示'}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-fg-muted">申请说明</dt>
            <dd class="mt-1 whitespace-pre-wrap">{detail.request_reason || '—'}</dd>
          </div>
        </dl>
      </section>
      <AuditSnapshotView
        snapshot={detail.current_snapshot}
        title={detail.action === 'DELETE' ? '待删除的站点数据' : '待恢复的站点数据'}
      />
    </div>
  )
}
