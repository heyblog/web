# Production environment template.
# Copy to .env.production on the deployment host and replace every placeholder.

# apps/api - production service bindings and health authentication
API_MIGRATION_DATABASE_URL=postgres://migrator:change-me@postgres:5432/heyblog?sslmode=require
API_DATABASE_URL=postgres://api_runtime:change-me@postgres:5432/heyblog?sslmode=require
API_REDIS_URL=redis://redis:6379/0
API_HEALTHCHECK_TOKEN=replace-with-random-healthcheck-token-32bytes

# apps/api <-> apps/web - production service authentication
API_WEB_TOKEN=replace-with-random-web-service-token-32bytes

# apps/web - production SSR upstream; replace the host with the private API service address
WEB_API_BASE_URL=http://replace-with-api-service:10201

# apps/web - optional server-only GitHub API token for member contribution data
GITHUB_TOKEN=
