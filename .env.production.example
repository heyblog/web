# Production environment template.
# Copy to .env.production on the deployment host and replace every placeholder.

# apps/api - production service bindings and internal authentication
# The PostgreSQL server must start with max_locks_per_transaction >= 512 for the temporary import.
API_MIGRATION_DATABASE_URL=postgres://migrator:change-me@host.docker.internal:5432/heyblog?sslmode=require
API_DATABASE_URL=postgres://api_runtime:change-me@host.docker.internal:5432/heyblog?sslmode=require
API_REDIS_URL=redis://:change-me@redis:6379/0
API_HEALTHCHECK_TOKEN=replace-with-random-healthcheck-token-32bytes
API_TEMP_IMPORT_TOKEN=replace-with-random-temp-import-token-32bytes

# apps/api <-> apps/web - production service authentication
API_WEB_TOKEN=replace-with-random-web-service-token-32bytes
API_AUTH_ACCESS_SECRET=replace-with-random-auth-access-secret-32bytes
API_AUTH_REFRESH_SECRET=replace-with-random-auth-refresh-secret-32bytes
API_GITHUB_CLIENT_ID=replace-with-github-client-id
API_GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# apps/api - AWS SES credentials read by the AWS SDK default chain
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
# Required only for temporary STS credentials.
# AWS_SESSION_TOKEN=replace-with-aws-session-token

# apps/web - production SSR upstream on the private Compose network
WEB_API_BASE_URL=http://api:10201

# apps/web - optional server-only GitHub API token for member contribution data
GITHUB_TOKEN=

# infra/docker - Redis authentication; keep synchronized with API_REDIS_URL
REDIS_PASSWORD=change-me
# Private bridge CIDR allowed by PostgreSQL pg_hba.conf. Keep the API production
# config http.trusted_proxies value synchronized with this subnet.
HEYBLOG_NETWORK_SUBNET=172.31.0.0/24
