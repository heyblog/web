{
  "name": "heyblog-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "format": "pnpm run format:root && pnpm -r --if-present run format",
    "format:root": "prettier --config ./packages/node/configs/prettier.config.ts --write \".github/**/*.yaml\" \".golangci.yaml\" \"Taskfile.yaml\" \"taskfiles/**/*.yaml\" \"apps/*/Taskfile.yaml\" \"infra/**/*.yaml\" \"commitlint.config.cjs\" \"package.json\" \"pnpm-workspace.yaml\" \"renovate.json\" \"scripts/**/*.mjs\"",
    "format:check": "pnpm run format:check:root && pnpm -r --if-present run format:check",
    "format:check:root": "prettier --config ./packages/node/configs/prettier.config.ts --check \".github/**/*.yaml\" \".golangci.yaml\" \"Taskfile.yaml\" \"taskfiles/**/*.yaml\" \"apps/*/Taskfile.yaml\" \"infra/**/*.yaml\" \"commitlint.config.cjs\" \"package.json\" \"pnpm-workspace.yaml\" \"renovate.json\" \"scripts/**/*.mjs\"",
    "lint": "pnpm run lint:root && pnpm -r --if-present run lint",
    "lint:root": "eslint --config ./packages/node/configs/eslint.config.ts \"commitlint.config.cjs\" \"scripts/**/*.mjs\"",
    "lint:fix": "pnpm run lint:fix:root && pnpm -r --if-present run lint:fix",
    "lint:fix:root": "eslint --config ./packages/node/configs/eslint.config.ts \"commitlint.config.cjs\" \"scripts/**/*.mjs\" --fix",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "cross-spawn": "^7.0.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}
