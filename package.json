{
  "name": "heyblog-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --config ./packages/node/configs/prettier.config.ts --write \".github/**/*.yaml\" \".golangci.yaml\" \"infra/**/*.yaml\" \"*.{cjs,ts,json}\" \"pnpm-workspace.yaml\" \"renovate.json\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --config ./packages/node/configs/prettier.config.ts --check \".github/**/*.yaml\" \".golangci.yaml\" \"infra/**/*.yaml\" \"*.{cjs,ts,json}\" \"pnpm-workspace.yaml\" \"renovate.json\" \"scripts/**/*.mjs\"",
    "lint": "eslint --config ./eslint.config.ts \"*.{cjs,ts}\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint --config ./eslint.config.ts \"*.{cjs,ts}\" \"scripts/**/*.mjs\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
